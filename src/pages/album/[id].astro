---
import Layout from '../../layouts/Layout.astro';
import { createSupabaseServerClient } from '../../lib/supabaseServer';
import TrackTableHeader from '../../components/TrackTableHeader.astro';
import TrackRow from '../../components/TrackRow.astro';
import PlayButton from '../../components/PlayButton.astro';

const { id } = Astro.params;
const supabase = createSupabaseServerClient(Astro);

// Parallelize data fetching
const [ { data: album, error: albumError }, { data: tracksResult, error: tracksError } ] = await Promise.all([
  supabase.from('albums').select('*').eq('id', id).single(),
  supabase.from('tracks').select('*').eq('album_id', id).order('id', { ascending: true })
]);

if (albumError) console.error('Album fetch error:', albumError);
if (tracksError) console.error('Tracks fetch error:', tracksError);

const chapters = tracksResult || [];
let totalDurationSeconds = 0;

if (album) {
  chapters.forEach((ch) => {
    if (ch.duration) {
      const parts = ch.duration.split(':').map(Number);
      if (parts.length === 2) {
        totalDurationSeconds += parts[0] * 60 + parts[1];
      } else if (parts.length === 3) {
        totalDurationSeconds += parts[0] * 3600 + parts[1] * 60 + parts[2];
      }
    }
  });
}

function formatTotalDuration(seconds: number) {
  const hrs = Math.floor(seconds / 3600);
  const mins = Math.floor((seconds % 3600) / 60);
  if (hrs > 0) return `${hrs} hr ${mins} min`;
  return `${mins} min`;
}

const totalDurationFormatted = formatTotalDuration(totalDurationSeconds);
---
<Layout backHref="/" hideNav>
  {album ? (
    <div class="relative min-h-screen">
      <!-- Immersive Header Background -->
      <div 
        class="absolute top-0 left-0 right-0 h-[400px] -z-10 blur-[80px] opacity-30"
        style={`background-image: url(${album.cover}); background-size: cover; background-position: center;`}
      ></div>
      <div class="absolute top-0 left-0 right-0 h-[400px] -z-20 bg-gradient-to-b from-white/10 to-transparent"></div>

      <div class="pt-20 px-2 sm:px-4 md:px-8 pb-8">
        <!-- Hero Header -->
        <div class="flex flex-col md:flex-row items-center md:items-end gap-6 md:gap-8 mb-8 px-2 sm:px-0">
          <div class="w-48 h-48 md:w-60 md:h-60 shrink-0 shadow-[0_30px_60px_rgba(0,0,0,0.8)] rounded-lg overflow-hidden group relative ring-1 ring-white/10">
            <img src={album.cover} alt={album.title} class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </div>
          
          <div class="flex flex-col gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-white/90">Album</span>
            <h1 class="text-4xl md:text-7xl font-heading font-extrabold text-white tracking-tight mb-2 leading-tight drop-shadow-xl">
              {album.title}
            </h1>
            <div class="flex items-center flex-wrap gap-2 text-sm font-bold text-white">
              <span class="hover:underline cursor-pointer">{album.artist}</span>
              <span class="text-white/60">•</span>
              <span class="text-white/60 font-medium">{chapters.length} songs</span>
            </div>
          </div>
        </div>

        <!-- Main Actions Bar -->
        <div class="flex items-center justify-between py-3 -mx-2 sm:-mx-4 md:-mx-8 px-4 sm:px-4 md:px-8 mb-4 border-b border-white/5 transition-all">
          <div class="flex items-center gap-4 sm:gap-5 md:gap-6">
            <PlayButton 
              bookId={album.id.toString()}
              chapIndex={0}
              trackId={chapters[0]?.id.toString()}
              class="w-12 h-12 rounded-full bg-brand-primary flex items-center justify-center text-white shadow-lg hover:scale-105 active:scale-95 transition-all"
              svgClass="w-6 h-6 ml-1"
            />
            <button class="text-white/40 hover:text-brand-primary transition-all active:scale-90" aria-label="Shuffle">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 3h5v5m-4.22 8.78l4.22 4.22M1 21s4.5-4.5 5.78-5.78M21 3L1 21M21 21h-5v-5M1 3s4.5 4.5 5.78 5.78"/></svg>
            </button>
            <button class="text-white/40 hover:text-brand-primary transition-all active:scale-90" aria-label="Favorite Album">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </button>
            <button class="text-white/60 hover:text-white transition-colors" aria-label="More Options">
               <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="2.5"/><circle cx="12" cy="12" r="2.5"/><circle cx="19" cy="12" r="2.5"/></svg>
            </button>
          </div>
          
          <div class="hidden md:flex items-center gap-4 text-white/70">
            <button class="p-2 hover:bg-white/10 rounded-full transition"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg></button>
            <div class="text-sm font-semibold flex items-center gap-2 cursor-pointer hover:text-white">
              Custom order 
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </div>
          </div>
        </div>

        <!-- Track Table -->
        <div class="mb-52">
          <!-- Table Header -->
          <TrackTableHeader className="mb-4" />

          <!-- Track List -->
          <div class="space-y-1">
            {chapters.map((ch, i) => (
              <TrackRow album={album} track={ch} index={i} />
            ))}
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="text-center text-white/80 py-20 px-6">
      <h2 class="text-2xl font-bold mb-2">Album not found</h2>
      <p>Please check the URL or go back to the album list.</p>
    </div>
  )}

  <style is:global>
    [data-player-row][data-active="true"] {
      background-color: rgba(255, 255, 255, 0.1);
    }
    [data-player-row][data-active="true"] [data-player-title] {
      color: #1db954;
    }
    [data-player-row][data-active="true"] [data-index-label] {
      color: #1db954;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

</Layout>

<script define:vars={{ albumId: album?.id, albumTitle: album?.title, albumCover: album?.cover, firstTrackId: chapters[0]?.id }}>
  function initStickyHeader() {
    const mainContent = document.getElementById('main-content');
    const dynamicZone = document.getElementById('header-dynamic-zone');
    
    if (mainContent && dynamicZone) {
      let isVisible = false;
      dynamicZone.innerHTML = ''; // Reset on init
      
      const scrollHandler = () => {
        if (mainContent.scrollTop > 300) {
          if (!isVisible) {
            isVisible = true;
            setTimeout(() => { if (window._updatePlayerRows) window._updatePlayerRows(); }, 10);
            dynamicZone.innerHTML = `
              <div class="flex items-center gap-3 sm:gap-4 transition-all duration-300 opacity-100 animate-in fade-in zoom-in-95">
                <button 
                  id="sticky-play-btn"
                  class="js-main-play-btn w-10 h-10 rounded-full bg-brand-primary flex items-center justify-center text-white shadow-lg hover:scale-105 active:scale-95 transition-all shrink-0"
                  data-player-album="${albumId}"
                >
                  <svg class="play-icon w-5 h-5 ml-1" viewBox="0 0 24 24" fill="currentColor"><path d="M5.25 5.036a.75.75 0 011.125-.66l12 7a.75.75 0 010 1.287l-12 7A.75.75 0 015.25 19.964V5.036z" /></svg>
                  <svg class="pause-icon hidden w-5 h-5 -ml-0.5" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1.5" /><rect x="14" y="5" width="4" height="14" rx="1.5" /></svg>
                </button>
                <div class="w-10 h-10 rounded shadow-md overflow-hidden shrink-0 hidden sm:block">
                   <img src="${albumCover}" class="w-full h-full object-cover" />
                </div>
                <div class="font-bold text-white text-base truncate max-w-[200px] md:max-w-[400px]">
                  ${albumTitle}
                </div>
              </div>
            `;
            
            const stickyPlay = document.getElementById('sticky-play-btn');
            if (stickyPlay) {
              stickyPlay.addEventListener('click', (e) => {
                 e.stopPropagation();
                 if (window.playerPlay) window.playerPlay({ bookId: albumId, chapIndex: 0, trackId: firstTrackId });
              });
            }
          }
        } else {
          if (isVisible) {
            isVisible = false;
            dynamicZone.innerHTML = '';
          }
        }
      };
      
      mainContent.addEventListener('scroll', scrollHandler);
      document.addEventListener('astro:before-swap', () => {
         mainContent.removeEventListener('scroll', scrollHandler);
         dynamicZone.innerHTML = '';
      }, { once: true });
    }
  }

  document.addEventListener('DOMContentLoaded', initStickyHeader);
  document.addEventListener('astro:page-load', initStickyHeader);
</script>
