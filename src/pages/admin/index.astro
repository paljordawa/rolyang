    .analytics-card { background: #0a0a0a; border: 1px solid #1a1a1a; padding: 25px; border-radius: 20px; }
    .analytics-card h3 { margin-top: 0; font-size: 1.2rem; margin-bottom: 20px; opacity: 0.6; }
    
    .stat-list { display: flex; flex-direction: column; gap: 15px; }
    .stat-item { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid #1a1a1a; }
    .stat-item-info { display: flex; flex-direction: column; }
    .track-title { font-weight: 700; font-size: 1rem; }
    .track-album { font-size: 0.75rem; color: #555; }
    .play-count { font-size: 1rem; color: #fff; }

    .popular-album { display: flex; gap: 20px; align-items: center; }
    .popular-album img { width: 100px; height: 100px; border-radius: 12px; }
    .pop-details h4 { margin: 0; font-size: 1.2rem; }
    .pop-details p { margin: 5px 0; color: #555; }
    .pop-plays { font-weight: 800; color: #fff; margin-top: 10px; }

    .modal-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.9); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(10px); }
    .modal-backdrop.active { display: flex; }
    .modal-window { background: #0a0a0a; border: 1px solid #1a1a1a; width: 450px; padding: 30px; border-radius: 24px; }
    .input-group { margin-bottom: 20px; }
    .input-group label { display: block; font-size: 0.8rem; color: #555; margin-bottom: 8px; font-weight: 700; }
    .input-group input { width: 100%; background: #1a1a1a; border: 1px solid #222; padding: 12px; border-radius: 10px; color: #fff; }
    .image-edit { display: flex; align-items: center; gap: 15px; }
    .image-edit img { width: 100px; height: 100px; border-radius: 12px; object-fit: cover; }
    .modal-footer { display: flex; justify-content: flex-end; gap: 15px; margin-top: 30px; }
    .btn-submit { background: #fff; border: none; color: #000; padding: 12px 25px; border-radius: 10px; font-weight: 800; cursor: pointer; }
    .btn-cancel { background: transparent; border: none; color: #555; cursor: pointer; }
  </style>

  <script is:inline>
    window.switchTab = (tabId) => {
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      document.getElementById('tab-' + tabId).classList.add('active');
      event.currentTarget.classList.add('active');
    };

    window.filterAlbums = () => {
      const q = document.getElementById('album-search').value.toLowerCase();
      document.querySelectorAll('.album-wrapper').forEach(row => {
        const text = row.getAttribute('data-search-text');
        row.style.display = text.includes(q) ? 'block' : 'none';
      });
    };

    window.sortAlbums = () => {
      const sortVal = document.getElementById('album-sort').value;
      const container = document.getElementById('album-list-container');
      const wrappers = Array.from(container.querySelectorAll('.album-wrapper'));

      wrappers.sort((a, b) => {
        if (sortVal === 'az') {
          return a.getAttribute('data-title').localeCompare(b.getAttribute('data-title'));
        } else if (sortVal === 'plays') {
          return parseInt(b.getAttribute('data-plays')) - parseInt(a.getAttribute('data-plays'));
        } else {
          // default (ID / Order) - assuming data-id contains the original sortable ID
          return a.getAttribute('data-id').localeCompare(b.getAttribute('data-id'));
        }
      });

      wrappers.forEach(w => container.appendChild(w));
    };

    window.toggleTracks = (tracksId) => {
      const el = document.getElementById(tracksId);
      if (el.style.display === 'none') {
        el.style.display = 'block';
        // Pause other audios when expanding a new one
        document.querySelectorAll('.admin-audio').forEach(a => a.pause());
      } else {
        el.style.display = 'none';
        // Pause all audios inside this expansion
        el.querySelectorAll('.admin-audio').forEach(a => a.pause());
      }
    };

    async function optimizeImage(file) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = 400; canvas.height = 400;
            const ctx = canvas.getContext('2d');
            const min = Math.min(img.width, img.height);
            ctx.drawImage(img, (img.width-min)/2, (img.height-min)/2, min, min, 0, 0, 400, 400);
            canvas.toBlob((blob) => resolve(blob), 'image/webp', 0.82);
          };
          img.src = e.target.result;
        };
        reader.readAsDataURL(file);
      });
    }

    window.openEdit = (id, title, artist, cover) => {
      document.getElementById('edit-album-id').value = id;
      document.getElementById('edit-title').value = title;
      document.getElementById('edit-artist').value = artist;
      document.getElementById('edit-preview').src = cover;
      document.getElementById('edit-modal').classList.add('active');
    };

    window.closeEdit = () => document.getElementById('edit-modal').classList.remove('active');

    window.previewEdit = (input) => {
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = (e) => document.getElementById('edit-preview').src = e.target.result;
        reader.readAsDataURL(input.files[0]);
      }
    };

    window.saveEdit = async function() {
      const id = document.getElementById('edit-album-id').value;
      const t = document.getElementById('edit-title').value;
      const a = document.getElementById('edit-artist').value;
      const file = document.getElementById('edit-cover-file').files[0];
      const btn = document.querySelector('.btn-submit');
      btn.textContent = 'Saving...'; btn.disabled = true;

      let coverUrl = null;
      if (file) {
        try {
          const blob = await optimizeImage(file);
          const fname = `album-${id.replace('album-','')}-${Date.now()}.webp`;
          const up = await fetch(`${window.SUPABASE_URL}/storage/v1/object/thumbnails/${fname}`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${window.SESSION_TOKEN}`, 'apikey': window.SUPABASE_ANON_KEY, 'Content-Type': 'image/webp' },
            body: blob
          });
          if (up.ok) coverUrl = `${window.SUPABASE_URL}/storage/v1/object/public/thumbnails/${fname}`;
        } catch (e) { alert(e.message); btn.disabled = false; return; }
      }

      const res = await fetch('/api/admin/edit-album', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ albumId: id, title: t, artist: a, coverUrl })
      });
      if (res.ok) location.reload(); else { alert("Error saving"); btn.disabled = false; }
    };

    window.delAlbum = async (id, title, e) => {
      if (!confirm(`Delete "${title}"?`)) return;
      const res = await fetch('/api/admin/delete-album', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ albumId: id })
      });
      if (res.ok) location.reload();
    };

    window.filterUsers = () => {
      const q = document.getElementById('user-search').value.toLowerCase();
      document.querySelectorAll('.user-wrapper').forEach(row => {
        const text = row.getAttribute('data-email');
        row.style.display = text.includes(q) ? 'block' : 'none';
      });
    };

    window.sortUsers = () => {
      const sortVal = document.getElementById('user-sort').value;
      const container = document.getElementById('user-list-container');
      const wrappers = Array.from(container.querySelectorAll('.user-wrapper'));

      wrappers.sort((a, b) => {
        if (sortVal === 'oldest') {
          return parseInt(a.getAttribute('data-joined')) - parseInt(b.getAttribute('data-joined'));
        } else if (sortVal === 'playlists') {
          return parseInt(b.getAttribute('data-playlists')) - parseInt(a.getAttribute('data-playlists'));
        } else {
          // default (newest)
          return parseInt(b.getAttribute('data-joined')) - parseInt(a.getAttribute('data-joined'));
        }
      });

      wrappers.forEach(w => container.appendChild(w));
    };

    window.toggleBanUser = async (id, email, isBanned) => {
      const action = isBanned ? 'Unban' : 'Ban';
      if (!confirm(`Are you sure you want to ${action} user "${email}"?`)) return;
      
      const res = await fetch('/api/admin/ban-user', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: id, isBanned: isBanned })
      });
      if (res.ok) location.reload();
      else alert(`Failed to ${action} user.`);
    };

    window.deleteUser = async (id, email) => {
      if (!confirm(`CRITICAL WARNING: Are you sure you want to PERMANENTLY DELETE user "${email}"? This action cannot be undone.`)) return;
      
      const res = await fetch('/api/admin/delete-user', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: id })
      });
      if (res.ok) location.reload();
      else alert(`Failed to delete user.`);
    };
  </script>
</AdminLayout>
