        </div>
      </div>
      <div class="flex gap-4 mt-10">
        <button class="flex-1 py-4 bg-white/5 hover:bg-white/10 text-white font-bold rounded-2xl transition-all" onclick="closeModal('edit-modal')">Cancel</button>
        <button class="flex-1 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl transition-all shadow-lg shadow-indigo-500/20" onclick="saveEditAlbum()">Save Changes</button>
      </div>
    </div>
  </div>

  <div id="edit-track-modal" class="modal-backdrop fixed inset-0 z-[200] bg-black/80 backdrop-blur-md opacity-0 invisible [&.active]:opacity-100 [&.active]:visible transition-all duration-300 flex items-center justify-center p-6">
    <div class="bg-[#0a0a0c] border border-white/10 w-full max-w-lg rounded-[40px] p-10 shadow-2xl translate-y-4 [.active>&]:translate-y-0 transition-transform duration-500">
      <h2 class="text-2xl font-black text-white mb-8">Edit Track</h2>
      <input type="hidden" id="et-track-id" />
      <input type="hidden" id="et-old-audio" />
      <div class="space-y-6">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Track Title</label>
          <input type="text" id="et-title" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white focus:outline-none focus:border-indigo-500 transition-all" />
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Select Genres (Max 2)</label>
          <input type="hidden" id="et-genre1" />
          <input type="hidden" id="et-genre2" />
          <div class="flex flex-wrap gap-2.5 my-3" id="edit-pill-container">
            <div class="genre-pill px-5 py-2.5 bg-white/5 border border-white/10 rounded-xl text-sm font-bold text-slate-400 cursor-pointer transition-all duration-300 select-none whitespace-nowrap hover:bg-white/10 hover:border-white/30 hover:text-white" data-val="" onclick="selectGenrePill('', this, 'edit')">No Genre</div>
            {
              allGenres.map((g) => (
                <div class="genre-pill px-5 py-2.5 bg-white/5 border border-white/10 rounded-xl text-sm font-bold text-slate-400 cursor-pointer transition-all duration-300 select-none whitespace-nowrap hover:bg-white/10 hover:border-white/30 hover:text-white" data-val={g.name} onclick={`selectGenrePill('${g.name}', this, 'edit')`}>{g.name}</div>
              ))
            }
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Update Audio File (Optional)</label>
          <input type="file" id="et-file" accept="audio/*" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white file:bg-indigo-600 file:border-none file:px-4 file:py-1 file:rounded-lg file:text-white file:text-xs file:font-bold file:mr-4 file:cursor-pointer" />
          <p class="text-[10px] text-slate-500 mt-2">Leave empty to keep existing file</p>
        </div>
      </div>
      <div class="flex gap-4 mt-10">
        <button class="flex-1 py-4 bg-white/5 hover:bg-white/10 text-white font-bold rounded-2xl transition-all" onclick="closeModal('edit-track-modal')">Cancel</button>
        <button class="flex-1 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl transition-all shadow-lg shadow-indigo-500/20" id="et-btn" onclick="saveTrackEdit()">Save Changes</button>
      </div>
    </div>
  </div>

  <div id="add-genre-modal" class="modal-backdrop fixed inset-0 z-[200] bg-black/80 backdrop-blur-md opacity-0 invisible [&.active]:opacity-100 [&.active]:visible transition-all duration-300 flex items-center justify-center p-6">
    <div class="bg-[#0a0a0c] border border-white/10 w-full max-w-lg rounded-[40px] p-10 shadow-2xl translate-y-4 [.active>&]:translate-y-0 transition-transform duration-500">
      <h2 class="text-2xl font-black text-white mb-8">Add Genre</h2>
      <div class="space-y-6">
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Genre Name</label>
          <input type="text" id="ag-name" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white focus:outline-none focus:border-indigo-500 transition-all" />
        </div>
      </div>
      <div class="flex gap-4 mt-10">
        <button class="flex-1 py-4 bg-white/5 hover:bg-white/10 text-white font-bold rounded-2xl transition-all" onclick="closeModal('add-genre-modal')">Cancel</button>
        <button class="flex-1 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl transition-all shadow-lg shadow-indigo-500/20" onclick="saveNewGenre()">Add Genre</button>
      </div>
    </div>
  </div>

  <div id="edit-artist-modal" class="modal-backdrop fixed inset-0 z-[200] bg-black/80 backdrop-blur-md opacity-0 invisible [&.active]:opacity-100 [&.active]:visible transition-all duration-300 flex items-center justify-center p-6">
    <div class="bg-[#0a0a0c] border border-white/10 w-full max-w-2xl rounded-[40px] p-10 shadow-2xl translate-y-4 [.active>&]:translate-y-0 transition-transform duration-500 max-h-[90vh] overflow-y-auto custom-scrollbar">
      <h2 class="text-2xl font-black text-white mb-8">Edit Artist Profile</h2>
      <div class="space-y-6">
        <div class="flex gap-6 items-start">
          <div class="w-24 h-24 rounded-full bg-white/5 border border-white/10 overflow-hidden shrink-0">
            <img id="ea-preview" src="" class="w-full h-full object-cover hidden" />
            <div id="ea-placeholder" class="w-full h-full flex items-center justify-center text-3xl font-bold text-slate-700">?</div>
          </div>
          <div class="flex-1">
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Artist Name</label>
            <input type="text" id="ea-name" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white opacity-50 cursor-not-allowed" readonly />
          </div>
        </div>
        
        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Thumbnail URL</label>
          <input type="text" id="ea-thumbnail" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white focus:outline-none focus:border-indigo-500 transition-all" placeholder="https://..." oninput="document.getElementById('ea-preview').src = this.value; document.getElementById('ea-preview').classList.toggle('hidden', !this.value); document.getElementById('ea-placeholder').classList.toggle('hidden', this.value);" />
        </div>

        <div>
          <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Biography</label>
          <textarea id="ea-bio" rows="4" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white focus:outline-none focus:border-indigo-500 transition-all resize-none"></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Instagram URL</label>
            <input type="text" id="ea-instagram" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white focus:outline-none focus:border-indigo-500 transition-all" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Facebook URL</label>
            <input type="text" id="ea-facebook" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white focus:outline-none focus:border-indigo-500 transition-all" />
          </div>
          <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-500 mb-2">Twitter URL</label>
            <input type="text" id="ea-twitter" class="w-full bg-white/5 border border-white/10 rounded-2xl py-4 px-6 text-white focus:outline-none focus:border-indigo-500 transition-all" />
          </div>
        </div>
      </div>
      <div class="flex gap-4 mt-10">
        <button class="flex-1 py-4 bg-white/5 hover:bg-white/10 text-white font-bold rounded-2xl transition-all" onclick="closeModal('edit-artist-modal')">Cancel</button>
        <button class="flex-1 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-2xl transition-all shadow-lg shadow-indigo-500/20" onclick="window.saveArtistProfile()">Save Profile</button>
      </div>
    </div>
  </div>

  <style is:global>
    .tab-content.hidden { display: none; }
    .tab-content:not(.active) { opacity: 0; }
    .tab-content.active { opacity: 1; }
  </style>
</AdminLayout>
