                      </td>
                      <td class="px-8 py-5">
                        <div class="flex items-center gap-2">
                          <span class={`w-2 h-2 rounded-full ${isBanned ? 'bg-rose-500 shadow-[0_0_10px_rgba(244,63,94,0.5)]' : 'bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]'}`}></span>
                          <span class="text-xs font-black uppercase tracking-widest text-slate-300">{isBanned ? 'Banned' : 'Active'}</span>
                        </div>
                      </td>
                      <td class="px-8 py-5 text-right">
                        <button class="px-5 py-2 bg-white/5 hover:bg-white/10 text-white text-[10px] font-black uppercase tracking-widest rounded-xl transition-all">
                          Manage
                        </button>
