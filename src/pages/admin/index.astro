                const provider = u.app_metadata?.provider || "email";
                const isBanned = u.banned_until != null;
                const userPlaylists = allPlaylists.filter(p => p.user_id === u.id);
                const lastSignIn = u.last_sign_in_at ? new Date(u.last_sign_in_at).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) : 'Never';

                return (
                  <>
                    <tr class="user-row group hover:bg-white/[0.04] transition-all cursor-pointer" data-email={u.email.toLowerCase()} onclick={`toggleUserDetail('detail-${u.id}')`}>
                      <td class="px-8 py-5">
