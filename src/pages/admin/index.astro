                    <tr id={`detail-${u.id}`} class="user-detail-row hidden bg-white/[0.02]">
                      <td colspan="4" class="px-10 py-8">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 animate-fade-in">
                          <div class="space-y-6">
                            <div>
                              <h4 class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-400 mb-4">Account Identity</h4>
                              <div class="space-y-4">
                                <div>
                                  <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Full Name</label>
                                  <div class="text-sm font-bold text-white">{name}</div>
                                </div>
                                <div>
                                  <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">User ID</label>
                                  <code class="text-[10px] font-medium text-indigo-300/70 block truncate">{u.id}</code>
                                </div>
                                <div>
                                  <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Provider</label>
                                  <span class="px-2 py-0.5 bg-white/5 rounded text-[10px] font-black text-slate-300 uppercase">{provider}</span>
                                </div>
                              </div>
                            </div>
                          </div>

                          <div class="space-y-6">
                            <div>
                              <h4 class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-400 mb-4">Activity & Playlists</h4>
                              <div class="space-y-4">
                                <div>
                                  <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Joined Date</label>
                                  <div class="text-sm font-bold text-white">{new Date(u.created_at).toLocaleDateString(undefined, { dateStyle: 'long' })}</div>
                                </div>
                                <div>
                                  <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Created Playlists</label>
                                  <div class="flex flex-wrap gap-2 mt-2">
                                    {userPlaylists.length > 0 ? (
                                      userPlaylists.map(p => (
                                        <span class="px-3 py-1 bg-indigo-500/10 text-indigo-300 text-[10px] font-bold rounded-lg border border-indigo-500/20">
                                          {p.name}
                                        </span>
                                      ))
                                    ) : (
                                      <span class="text-xs text-slate-500 italic">No playlists created</span>
                                    )}
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>

                          <div class="space-y-6">
                            <div>
                              <h4 class="text-[10px] font-black uppercase tracking-[0.2em] text-rose-500 mb-4">Danger Zone</h4>
                              <div class="flex flex-col gap-3">
                                <button 
                                  class={`w-full py-3 rounded-2xl text-xs font-black uppercase tracking-widest transition-all ${isBanned ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20 hover:bg-amber-500/20'}`}
                                  onclick={`event.stopPropagation(); window.toggleBanUser('${u.id}', '${u.email}', ${isBanned})`}
                                >
                                  {isBanned ? 'Unlock Account' : 'Restrict Account'}
                                </button>
                                <button 
                                  class="w-full py-3 bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 rounded-2xl text-xs font-black uppercase tracking-widest transition-all"
                                  onclick={`event.stopPropagation(); window.deleteUser('${u.id}', '${u.email}')`}
                                >
                                  Terminate User
                                </button>
                              </div>
                            </div>
                          </div>
                        </div>
                      </td>
                    </tr>
                  </>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

