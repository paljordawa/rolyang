---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createSupabaseServerClient } from '../../lib/supabaseServer';
import { createSupabaseAdminClient } from '../../lib/supabaseAdmin';

const supabase = createSupabaseServerClient(Astro);
const { data: { session } } = await supabase.auth.getSession();
const ADMIN_EMAIL = 'paljordawa@gmail.com';

if (!session || session.user.email !== ADMIN_EMAIL) {
  return Astro.redirect('/admin/login');
}

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const sessionToken = session?.access_token || '';

const admin = createSupabaseAdminClient();

let allUsers: any[] = [];
try {
  const { data: users } = await admin.auth.admin.listUsers();
  allUsers = users?.users || [];
} catch (e) {}

const [{ data: albums }, { data: tracks }, { data: playlists }] = await Promise.all([
  admin.from('albums').select('*').order('id'),
  admin.from('tracks').select('*').order('play_count', { ascending: false }),
  admin.from('playlists').select('*')
]);

const allAlbums = albums || [];
const allTracks = tracks || [];
const allPlaylists = playlists || [];

console.log(`[Admin Data Check] Albums: ${allAlbums.length}, Tracks: ${allTracks.length}, Users: ${allUsers.length}`);

// Calculate Audio Stats
const totalPlays = allTracks.reduce((sum, t) => sum + (t.play_count || 0), 0);
const topTracks = allTracks.slice(0, 5);

// Calculate Top Artists
const artistPlaysMap = {};
allTracks.forEach(t => {
  const album = allAlbums.find(a => a.id === t.album_id);
  if (album && album.artist) {
    artistPlaysMap[album.artist] = (artistPlaysMap[album.artist] || 0) + (t.play_count || 0);
  }
});
const topArtists = Object.entries(artistPlaysMap)
  .map(([artist, plays]) => ({ artist, plays }))
  .sort((a, b) => b.plays - a.plays)
  .slice(0, 5);

// Find most popular album
const albumPlays = allAlbums.map(a => {
  const p = allTracks.filter(t => t.album_id === a.id).reduce((sum, t) => sum + (t.play_count || 0), 0);
  return { ...a, totalPlays: p };
}).sort((a, b) => b.totalPlays - a.totalPlays);

const stats = {
  totalAlbums: allAlbums.length,
  totalUsers: allUsers.length,
  totalTracks: allTracks.length,
  totalPlaylists: allPlaylists.length,
  totalPlays: totalPlays.toLocaleString(),
  topAlbum: albumPlays[0]?.title || 'None'
};
---

<AdminLayout title="Rolyang Admin">
  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, sessionToken }}>
    window.SUPABASE_URL = SUPABASE_URL;
    window.SUPABASE_ANON_KEY = SUPABASE_ANON_KEY;
    window.SESSION_TOKEN = sessionToken;
  </script>

  <div class="admin-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="logo">Rolyang Admin</div>
      </div>
      <nav class="sidebar-nav">
        <button class="nav-item active" onclick="switchTab('library')">
          <span class="icon">🎵</span> Music Library
        </button>
        <button class="nav-item" onclick="switchTab('analytics')">
          <span class="icon">📈</span> Audio Analytics
        </button>
        <button class="nav-item" onclick="switchTab('users')">
          <span class="icon">👥</span> User Management
        </button>
      </nav>
      <div class="sidebar-footer">
        <p>{session.user.email}</p>
        <button onclick="supabase.auth.signOut().then(() => location.href='/')">Sign Out</button>
      </div>
    </aside>

    <main class="main-content">
      <!-- Library Tab -->
      <section id="tab-library" class="tab-content active">
        <header class="tab-header">
          <div class="header-info">
            <h2>Music Library</h2>
            <div class="stats-overview">
              <div class="stat-card">
                <span class="stat-value">{stats.totalAlbums}</span>
                <span class="stat-label">Total Albums</span>
              </div>
              <div class="stat-card">
                <span class="stat-value">{stats.totalTracks}</span>
                <span class="stat-label">Total Tracks</span>
              </div>
              <div class="stat-card">
                <span class="stat-value">{stats.totalPlaylists}</span>
                <span class="stat-label">Total Playlists</span>
              </div>
              <div class="stat-card">
                <span class="stat-value">{stats.totalPlays}</span>
                <span class="stat-label">Total Plays</span>
              </div>
            </div>
          </div>
          <div class="header-actions">
            <div class="sort-controls">
              <select id="album-sort" onchange="sortAlbums()" class="admin-select">
                <option value="default">Sort: Default (ID)</option>
                <option value="az">Sort: A-Z (Title)</option>
                <option value="plays">Sort: Most Played</option>
              </select>
            </div>
            <div class="search-bar">
              <input type="text" id="album-search" placeholder="Search albums..." oninput="filterAlbums()" />
            </div>
            <a href="/admin/add-album" class="btn-add">Add Album</a>
          </div>
        </header>

        <div class="album-list" id="album-list-container">
          {allAlbums.map(album => {
            const ts = allTracks.filter(t => t.album_id === album.id);
            const ap = ts.reduce((sum, t) => sum + (t.play_count || 0), 0);
            return (
              <div class="album-wrapper" data-search-text={`${album.title} ${album.artist}`.toLowerCase()} data-title={album.title} data-plays={ap} data-id={album.id}>
                <div class="album-row">
                  <img src={album.cover} alt="" />
                  <div class="details">
                    <h3>{album.title}</h3>
                    <p>{album.artist} • {ts.length} Tracks • {ap.toLocaleString()} Plays</p>
                  </div>
                  <div class="row-actions">
                    <button class="btn-view" onclick={`toggleTracks('tracks-${album.id}')`}>Tracks</button>
                    <button class="btn-edit" onclick={`openEdit('${album.id}', ${JSON.stringify(album.title)}, ${JSON.stringify(album.artist)}, ${JSON.stringify(album.cover)})`}>Edit</button>
                    <button class="btn-delete" onclick={`delAlbum('${album.id}', ${JSON.stringify(album.title)}, event)`}>Delete</button>
                  </div>
                </div>
                
                <div id={`tracks-${album.id}`} class="album-tracks-expansion" style="display: none;">
                  <div class="expansion-header">
                    <h4>Tracklist</h4>
                  </div>
                  {ts.length === 0 ? (
                    <div class="empty-tracks">No tracks found.</div>
                  ) : (
                    <div class="track-table">
                      {ts.map((t, index) => (
                        <div class="track-row">
                          <div class="track-num">{index + 1}</div>
                          <div class="track-info">
                            <span class="track-title">{t.title}</span>
                          </div>
                          <div class="track-plays">{(t.play_count || 0).toLocaleString()} plays</div>
                          <div class="track-preview">
                            <audio controls src={t.audio} preload="none" class="admin-audio"></audio>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )
          })}
        </div>
      </section>

      <!-- Analytics Tab -->
      <section id="tab-analytics" class="tab-content">
        <header class="tab-header">
          <h2>Audio Analytics</h2>
        </header>
        
        <div class="analytics-grid">
          <div class="analytics-card">
            <h3>Top 5 Tracks</h3>
            <div class="stat-list">
              {topTracks.map(t => (
                <div class="stat-item">
                  <div class="stat-item-info">
                    <span class="track-title">{t.title}</span>
                    <span class="track-album">{allAlbums.find(a => a.id === t.album_id)?.title}</span>
                  </div>
                  <strong class="play-count">{(t.play_count || 0).toLocaleString()} plays</strong>
                </div>
              ))}
            </div>
          </div>

          <div class="analytics-col">
            <div class="analytics-card" style="margin-bottom: 20px;">
              <h3>Most Popular Album</h3>
              <div class="popular-album">
                {albumPlays[0] && (
                  <>
                    <img src={albumPlays[0].cover} alt="" />
                    <div class="pop-details">
                      <h4>{albumPlays[0].title}</h4>
                      <p>{albumPlays[0].artist}</p>
                      <div class="pop-plays">{(albumPlays[0].totalPlays || 0).toLocaleString()} Total Plays</div>
                    </div>
                  </>
                )}
              </div>
            </div>

            <div class="analytics-card">
              <h3>Top Artists</h3>
              <div class="stat-list" style="margin-top: 15px;">
                {topArtists.map((artist, idx) => (
                  <div class="stat-item" style="padding-bottom: 8px;">
                    <div class="stat-item-info">
                      <span class="track-title" style="display: flex; gap: 10px;">
                        <span style="opacity: 0.5;">#{idx + 1}</span> {artist.artist}
                      </span>
                    </div>
                    <strong class="play-count" style="font-size: 0.9rem;">{artist.plays.toLocaleString()} plays</strong>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Users Tab -->
      <section id="tab-users" class="tab-content">
        <header class="tab-header">
          <div class="header-info">
            <h2>User Management</h2>
          </div>
          <div class="header-actions">
            <div class="sort-controls">
              <select id="user-sort" onchange="sortUsers()" class="admin-select">
                <option value="newest">Sort: Newest First</option>
                <option value="oldest">Sort: Oldest First</option>
                <option value="playlists">Sort: Most Playlists</option>
              </select>
            </div>
            <div class="search-bar">
              <input type="text" id="user-search" placeholder="Search users by email..." oninput="filterUsers()" />
            </div>
          </div>
        </header>
        
        <div class="user-list" id="user-list-container">
          {allUsers.map(user => {
            const userPlaylists = allPlaylists.filter(p => p.user_id === user.id);
            const isBanned = user.banned_until != null && new Date(user.banned_until) > new Date();
            const lastLogin = user.last_sign_in_at ? new Date(user.last_sign_in_at).toLocaleDateString() : 'Never';
            
            return (
              <div class="album-wrapper user-wrapper" data-email={user.email.toLowerCase()} data-joined={new Date(user.created_at).getTime()} data-playlists={userPlaylists.length}>
                <div class="album-row" style="align-items: flex-start;">
                  <div class="details" style="display: flex; flex-direction: column; gap: 8px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <h3 style="margin: 0; font-size: 1.2rem;">{user.email}</h3>
                      {isBanned ? 
                        <span style="background: #ef4444; color: #fff; font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: 800;">BANNED</span> : 
                        <span style="background: #10b981; color: #fff; font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: 800;">ACTIVE</span>
                      }
                    </div>
                    <div style="font-size: 0.85rem; color: #888; display: flex; gap: 15px;">
                      <span><strong>Joined:</strong> {new Date(user.created_at).toLocaleDateString()}</span>
                      <span><strong>Last Login:</strong> {lastLogin}</span>
                      <span><strong>Playlists:</strong> {userPlaylists.length}</span>
                    </div>
                  </div>
                  <div class="row-actions" style="margin-top: 5px;">
                    <button class="btn-view" onclick={`toggleTracks('playlists-${user.id}')`}>View Playlists</button>
                    <button class="btn-edit" style="background: #fbbf24; color: #000;" onclick={`toggleBanUser('${user.id}', '${user.email}', ${isBanned})`}>
                      {isBanned ? 'Unban' : 'Ban'}
                    </button>
                    <button class="btn-delete" onclick={`deleteUser('${user.id}', '${user.email}')`}>Delete</button>
                  </div>
                </div>

                <div id={`playlists-${user.id}`} class="album-tracks-expansion" style="display: none;">
                  <div class="expansion-header">
                    <h4>User Playlists</h4>
                  </div>
                  {userPlaylists.length === 0 ? (
                    <div class="empty-tracks">This user hasn't created any playlists.</div>
                  ) : (
                    <div class="track-table">
                      {userPlaylists.map((p, idx) => (
                        <div class="track-row">
                          <div class="track-num">{idx + 1}</div>
                          <div class="track-info">
                            <span class="track-title">{p.title}</span>
                          </div>
                          <div class="track-plays">Created: {new Date(p.created_at).toLocaleDateString()}</div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    </main>
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="modal-backdrop">
    <div class="modal-window">
      <h2>Edit Album</h2>
      <input type="hidden" id="edit-album-id" />
      <div class="input-group"><label>Title</label><input type="text" id="edit-title" /></div>
      <div class="input-group"><label>Artist</label><input type="text" id="edit-artist" /></div>
      <div class="input-group">
        <label>Cover</label>
        <div class="image-edit"><img id="edit-preview" /><input type="file" onchange="previewEdit(this)" id="edit-cover-file" /></div>
      </div>
      <div class="modal-footer">
        <button class="btn-cancel" onclick="closeEdit()">Cancel</button>
        <button class="btn-submit" onclick="saveEdit()">Save Changes</button>
      </div>
    </div>
  </div>

  <style>
