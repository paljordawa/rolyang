---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabaseServer";
import { createSupabaseAdminClient } from "../../lib/supabaseAdmin";

const supabase = createSupabaseServerClient(Astro);
const {
  data: { session },
} = await supabase.auth.getSession();
const ADMIN_EMAIL = "paljordawa@gmail.com";

if (!session || session.user.email !== ADMIN_EMAIL) {
  return Astro.redirect("/admin/login");
}

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const sessionToken = session?.access_token || "";

const admin = createSupabaseAdminClient();

let allUsers: any[] = [];
try {
  const { data: users } = await admin.auth.admin.listUsers();
  allUsers = users?.users || [];
} catch (e) {}

const [{ data: albums }, { data: tracks }, { data: playlists }, { data: genres }] =
  await Promise.all([
    admin.from("albums").select("*").order("id"),
    admin.from("tracks").select("*").order("play_count", { ascending: false }),
    admin.from("playlists").select("*"),
    admin.from("genres").select("*").order("name"),
  ]);

const allAlbums = albums || [];
const allTracks = tracks || [];
const allPlaylists = playlists || [];
const allGenres = genres || [];

// Calculate Top Artists
const artistPlaysMap = {};
allTracks.forEach((t) => {
  const album = allAlbums.find((a) => a.id === t.album_id);
  if (album && album.artist) {
    artistPlaysMap[album.artist] =
      (artistPlaysMap[album.artist] || 0) + (t.play_count || 0);
  }
});

// Fetch artist profiles if they exist
let allArtistProfiles: any[] = [];
try {
  const { data: profiles } = await admin.from("artists").select("*");
  allArtistProfiles = profiles || [];
} catch (e) {}

// Calculate unique artists from albums
const uniqueArtistNames = Array.from(new Set(allAlbums.map(a => a.artist))).filter(Boolean);
const allArtists = uniqueArtistNames.map(name => {
  const artistAlbums = allAlbums.filter(a => a.artist === name);
  const albumIds = artistAlbums.map(a => a.id);
  const artistTracks = allTracks.filter(t => albumIds.includes(t.album_id));
  
  const profile = allArtistProfiles.find(p => p.name === name);
  return {
    name,
    albumCount: artistAlbums.length,
    trackCount: artistTracks.length,
    playCount: artistPlaysMap[name] || 0,
    thumbnail: profile?.thumbnail || null,
    bio: profile?.bio || "",
    socials: {
      instagram: profile?.social_instagram || "",
      facebook: profile?.social_facebook || "",
      twitter: profile?.social_twitter || ""
    }
  };
});

// Calculate Audio Stats
const totalPlays = allTracks.reduce((sum, t) => sum + (t.play_count || 0), 0);
const topTracks = allTracks.slice(0, 5);

const topArtists = Object.entries(artistPlaysMap)
  .map(([artist, plays]) => ({ artist, plays }))
  .sort((a, b) => (b.plays as number) - (a.plays as number))
  .slice(0, 5);

// Find most popular album
const albumPlays = allAlbums
  .map((a) => {
    const p = allTracks
      .filter((t) => t.album_id === a.id)
      .reduce((sum, t) => sum + (t.play_count || 0), 0);
    return { ...a, totalPlays: p };
  })
  .sort((a, b) => b.totalPlays - a.totalPlays);

const stats = {
  totalAlbums: allAlbums.length,
  totalUsers: allUsers.length,
  totalTracks: allTracks.length,
  totalPlaylists: allPlaylists.length,
  totalPlays: totalPlays.toLocaleString(),
  topAlbum: albumPlays[0]?.title || "None",
};
---

<AdminLayout title="Rolyang Admin">
  <!-- Data Serialization for Client -->
  <script
    is:inline
    id="tracks-json"
    type="application/json"
    set:html={JSON.stringify(allTracks)}
  />
  <script
    is:inline
    define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, sessionToken }}
  >
    window.SUPABASE_URL = SUPABASE_URL;
    window.SUPABASE_ANON_KEY = SUPABASE_ANON_KEY;
    window.SESSION_TOKEN = sessionToken;

    // Initialize Supabase Client
    (async () => {
      const { createBrowserClient } =
        await import("https://cdn.jsdelivr.net/npm/@supabase/ssr@latest/+esm");
      window.supabase = createBrowserClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    })();

    window.openEditArtist = (name, thumbnail, bio, socialsRaw) => {
      const socials = JSON.parse(socialsRaw);
      document.getElementById("ea-name").value = name;
      document.getElementById("ea-thumbnail").value = thumbnail || "";
      document.getElementById("ea-bio").value = bio || "";
      document.getElementById("ea-instagram").value = socials.instagram || "";
      document.getElementById("ea-facebook").value = socials.facebook || "";
      document.getElementById("ea-twitter").value = socials.twitter || "";
      
      const preview = document.getElementById("ea-preview");
      const placeholder = document.getElementById("ea-placeholder");
      if (thumbnail) {
        preview.src = thumbnail;
        preview.classList.remove("hidden");
        placeholder.classList.add("hidden");
      } else {
        preview.classList.add("hidden");
        placeholder.classList.remove("hidden");
      }
      
      window.openModal("edit-artist-modal");
    };

    window.saveArtistProfile = async () => {
      const name = document.getElementById("ea-name").value;
      const thumbnail = document.getElementById("ea-thumbnail").value;
      const bio = document.getElementById("ea-bio").value;
      const instagram = document.getElementById("ea-instagram").value;
      const facebook = document.getElementById("ea-facebook").value;
      const twitter = document.getElementById("ea-twitter").value;
      
      const btn = event.target;
      btn.textContent = "Saving...";
      btn.disabled = true;

      try {
        const res = await fetch("/api/admin/artists", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, thumbnail, bio, instagram, facebook, twitter }),
        });
        if (res.ok) location.reload();
        else {
          const data = await res.json();
          alert("Error: " + (data.error || "Failed to save"));
        }
      } catch (e) {
        alert("Network error: " + e.message);
      } finally {
        btn.textContent = "Save Profile";
        btn.disabled = false;
      }
    };

    window.handleLogout = async () => {
      if (window.supabase) {
        await window.supabase.auth.signOut();
      }
      location.href = "/";
    };

    // Tab Logic
    window.switchTab = (tab) => {
      console.log("Switching to tab:", tab);
      window.currentTab = tab;
      
      const activeClasses = ["bg-indigo-600", "text-white", "shadow-lg", "shadow-indigo-500/20"];
      const inactiveClasses = ["text-slate-400", "hover:bg-white/5", "hover:text-white"];

      // 1. Reset all tabs
      document.querySelectorAll(".tab-content").forEach((t) => {
        t.classList.remove("active");
        t.classList.add("hidden");
      });

      // 2. Reset all buttons
      document.querySelectorAll(".nav-btn").forEach((b) => {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
      });

      // 3. Activate target tab
      const target = document.getElementById("tab-" + tab);
      if (target) {
        target.classList.remove("hidden");
        // Force reflow for animation
        target.offsetHeight; 
        target.classList.add("active");
      } else {
        console.warn("Target tab not found:", "tab-" + tab);
      }
      
      // 4. Activate target button
      const btn = document.getElementById("btn-tab-" + tab);
      if (btn) {
        btn.classList.add(...activeClasses);
        btn.classList.remove(...inactiveClasses);
      }

      if (tab === "genres") loadGenres();
    };

    // --- Global Action Handlers (Define First) ---
    window.editGenre = async (id, oldName) => {
      const newName = prompt("Enter new name for genre:", oldName);
      if (!newName || newName === oldName) return;
      try {
        const res = await fetch("/api/admin/genres", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, name: newName, oldName }),
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        loadGenres();
      } catch (err) {
        alert("Failed to edit: " + err.message);
      }
    };

    window.promptAddGenre = () => {
      const name = prompt("Enter new genre name:");
      if (!name || !name.trim()) return;
      addGenre(name.trim());
    };

    window.delGenre = async (id, name) => {
      if (!confirm(`Delete genre "${name}"?`)) return;
      try {
        const res = await fetch(`/api/admin/genres?id=${id}`, {
          method: "DELETE",
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        loadGenres();
      } catch (err) {
        alert("Failed to delete: " + err.message);
      }
    };

    async function addGenre(name) {
      try {
        const res = await fetch("/api/admin/genres", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name }),
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        loadGenres();
      } catch (err) {
        alert("Failed to add genre: " + err.message);
      }
    }

    // Global data passed from server
    window.ALL_TRACKS = JSON.parse(
      document.getElementById("tracks-json").textContent,
    );

    window.loadGenres = async () => {
      const container = document.getElementById("genres-table-body");
      if (!container) return;
      try {
        const res = await fetch("/api/admin/genres");
        const genres = await res.json();
        const tracks = window.ALL_TRACKS || [];

        if (genres.error) throw new Error(genres.error);
        
        container.innerHTML = genres
          .map(
            (g) => `
            <tr class="hover:bg-white/[0.03] transition-colors">
              <td class="px-8 py-5 text-sm font-bold text-white">${g.name}</td>
              <td class="px-8 py-5 text-right">
                <div class="flex justify-end gap-2">
                  <button class="px-4 py-1.5 bg-white/5 border border-white/5 text-xs font-bold text-white rounded-lg hover:bg-white/10 transition-all" 
                          data-id="${g.id}" 
                          data-name="${g.name.replace(/"/g, "&quot;")}" 
                          onclick="window.editGenre(this.dataset.id, this.dataset.name)">Edit</button>
                  <button class="px-4 py-1.5 bg-rose-600/10 border border-rose-500/20 text-xs font-bold text-rose-400 rounded-lg hover:bg-rose-600/20 transition-all" 
                          data-id="${g.id}" 
                          data-name="${g.name.replace(/"/g, "&quot;")}" 
                          onclick="window.delGenre(this.dataset.id, this.dataset.name)">Delete</button>
                </div>
              </td>
            </tr>
          `,
          )
          .join("");
      } catch (err) {
        console.error("Failed to load genres:", err);
      }
    };

    // UI Utilities
    window.toggleMenu = (id) => {
      const menu = document.getElementById(id);
      const wasActive = menu.classList.contains("active");
      document
        .querySelectorAll(".dropdown-menu")
        .forEach((m) => m.classList.remove("active"));
      if (!wasActive) menu.classList.add("active");
      event.stopPropagation();
    };

    window.toggleTracks = (id) => {
      const el = document.getElementById(id);
      el.classList.toggle("hidden");
    };

    window.toggleUserDetail = (id) => {
      const el = document.getElementById(id);
      const wasHidden = el.classList.contains("hidden");
      
      // Close all other detail rows
      document.querySelectorAll(".user-detail-row").forEach((row) => {
        row.classList.add("hidden");
        row.classList.remove("animate-fade-in");
      });

      // Toggle target
      if (wasHidden) {
        el.classList.remove("hidden");
        el.classList.add("animate-fade-in");
      }
    };

    window.openModal = (id) => document.getElementById(id).classList.add("active");
    window.closeModal = (id) => document.getElementById(id).classList.remove("active");

    // Search & Filter
    window.filterLibrary = () => {
      const albumQuery = (
        document.getElementById("album-search")?.value || ""
      ).toLowerCase();
      const songQuery = (
        document.getElementById("song-search")?.value || ""
      ).toLowerCase();

      document.querySelectorAll(".album-card-wrapper").forEach((el) => {
        const text = el.getAttribute("data-search-text") || "";
        el.style.display = text.includes(albumQuery) ? "block" : "none";
      });

      document.querySelectorAll(".table-row-v2").forEach((el) => {
        const text = el.getAttribute("data-search-text") || "";
        el.style.display = text.includes(songQuery) ? "flex" : "none";
      });
    };

    window.filterUsers = () => {
      const q = (document.getElementById("user-search")?.value || "").toLowerCase();
      document.querySelectorAll(".user-row").forEach((el) => {
        const email = el.getAttribute("data-email") || "";
        const match = email.includes(q);
        el.style.display = match ? "table-row" : "none";
        
        // Also hide detail row if main row is hidden
        const detailId = el.getAttribute("onclick")?.match(/'(detail-[^']+)'/)?.[1];
        if (detailId) {
           const detail = document.getElementById(detailId);
           if (!match && detail) detail.classList.add("hidden");
        }
      });
    };

    window.filterArtists = () => {
      const q = (document.getElementById("artist-search")?.value || "").toLowerCase();
      document.querySelectorAll(".artist-item").forEach((el) => {
        const name = el.getAttribute("data-name").toLowerCase();
        const match = name.includes(q);
        el.classList.toggle("hidden", !match);
      });
    };

    window.switchArtistView = (view) => {
      const grid = document.getElementById("artist-grid-view");
      const list = document.getElementById("artist-list-view");
      const gridBtn = document.getElementById("btn-view-grid");
      const listBtn = document.getElementById("btn-view-list");

      if (view === "grid") {
        grid.classList.remove("hidden");
        list.classList.add("hidden");
        gridBtn.classList.add("bg-indigo-600", "text-white");
        gridBtn.classList.remove("text-slate-400");
        listBtn.classList.remove("bg-indigo-600", "text-white");
        listBtn.classList.add("text-slate-400");
      } else {
        grid.classList.add("hidden");
        list.classList.remove("hidden");
        listBtn.classList.add("bg-indigo-600", "text-white");
        listBtn.classList.remove("text-slate-400");
        gridBtn.classList.remove("bg-indigo-600", "text-white");
        gridBtn.classList.add("text-slate-400");
      }
    };

    window.filterTracks = () => {
      const q = (document.getElementById("song-search")?.value || "").toLowerCase();
      const artist = document.getElementById("filter-artist").value;
      const genre = window.currentFilterGenre || "";

      document.querySelectorAll(".table-row-v2").forEach((el) => {
        const searchText = el.getAttribute("data-search-text") || "";
        const rowArtist = el.getAttribute("data-artist") || "";
        const rowGenres = (el.getAttribute("data-genres") || "").split(" ");

        const matchesSearch = searchText.includes(q);
        const matchesArtist = !artist || rowArtist === artist;
        const matchesGenre = !genre || rowGenres.includes(genre);

        if (matchesSearch && matchesArtist && matchesGenre) {
          el.style.display = "flex";
        } else {
          el.style.display = "none";
        }
      });
    };
    window.saveNewTrack = async (albumId) => {
      const title = document.getElementById(`at-title-${albumId}`).value;
      const genre1 = document.getElementById(`at-genre1-${albumId}`).value;
      const genre2 = document.getElementById(`at-genre2-${albumId}`).value;
      const file = document.getElementById(`at-file-${albumId}`).files[0];
      const btn = document.getElementById(`at-btn-${albumId}`);
      
      if (!title || !file) return alert("Title and Audio File are required.");
      
      btn.textContent = "Uploading...";
      btn.disabled = true;

      try {
        const fname = `${albumId}-t${Date.now()}.${file.name.split(".").pop()}`;
        const up = await fetch(
          `${window.SUPABASE_URL}/storage/v1/object/audio/${fname}`,
          {
            method: "POST",
            headers: {
              Authorization: `Bearer ${window.SESSION_TOKEN}`,
              apikey: window.SUPABASE_ANON_KEY,
              "Content-Type": file.type,
            },
            body: file,
          },
        );
        if (!up.ok) throw new Error("Upload failed");
        
        const audioUrl = `${window.SUPABASE_URL.replace(/\/$/, "")}/storage/v1/object/public/audio/${fname}`;
        const res = await fetch("/api/admin/add-track", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ albumId, title, genre: genre1, genre2, audioUrl }),
        });
        
        if (res.ok) location.reload();
        else {
          const data = await res.json();
          alert("Error saving track: " + data.error);
        }
      } catch (e) {
        alert(e.message);
      } finally {
        btn.textContent = "Upload Track";
        btn.disabled = false;
      }
    };

    window.openEditAlbum = (id, title, artist, cover) => {
      document.getElementById("edit-album-id").value = id;
      document.getElementById("edit-title").value = title;
      document.getElementById("edit-artist").value = artist;
      document.getElementById("edit-preview").src = cover;
      document.getElementById("edit-modal").classList.add("active");
    };

    window.saveEditAlbum = async () => {
      const id = document.getElementById("edit-album-id").value;
      const t = document.getElementById("edit-title").value;
      const a = document.getElementById("edit-artist").value;
      const res = await fetch("/api/admin/edit-album", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ albumId: id, title: t, artist: a }),
      });
      if (res.ok) location.reload();
      else alert("Error saving changes");
    };

    window.toggleBanUser = async (id, email, isBanned) => {
      if (!confirm(`${isBanned ? "Unban" : "Ban"} ${email}?`)) return;
      const res = await fetch("/api/admin/ban-user", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId: id, isBanned }),
      });
      if (res.ok) location.reload();
    };

    window.deleteUser = async (id, email) => {
      if (!confirm(`Permanently delete ${email}?`)) return;
      const res = await fetch("/api/admin/delete-user", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ userId: id }),
      });
      if (res.ok) location.reload();
    };
    window.delAlbum = async (id) => {
      if (!confirm(`Delete album?`)) return;
      const res = await fetch("/api/admin/delete-album", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ albumId: id }),
      });
      if (res.ok) location.reload();
    };

    window.delTrack = async (id, title, audioUrl) => {
      if (!confirm(`Delete "${title}"?`)) return;
      const res = await fetch("/api/admin/delete-track", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ trackId: id, audioUrl }),
      });
      if (res.ok) location.reload();
    };

    window.selectGenrePill = (val, el, type, albumId = null) => {
      const prefix = type === 'add' ? `at-genre` : `et-genre`;
      const g1Id = albumId ? `${prefix}1-${albumId}` : `${prefix}1`;
      const g2Id = albumId ? `${prefix}2-${albumId}` : `${prefix}2`;
      const containerId = albumId ? `${type}-pill-container-${albumId}` : `${type}-pill-container`;
      
      const g1 = document.getElementById(g1Id);
      const g2 = document.getElementById(g2Id);

      const activeClasses = ["bg-gradient-to-br", "from-indigo-600", "to-indigo-400", "border-indigo-500", "text-white", "shadow-[0_8px_20px_rgba(99,102,241,0.4)]", "-translate-y-0.5"];
      const inactiveClasses = ["bg-white/5", "border-white/10", "text-slate-400"];

      // If clicking already selected genre, deselect it
      if (g1.value === val) {
        g1.value = g2.value;
        g2.value = "";
      } else if (g2.value === val) {
        g2.value = "";
      } else {
        // New selection
        if (!g1.value) g1.value = val;
        else if (!g2.value) g2.value = val;
        else {
          // Replace second genre if already two selected
          g2.value = val;
        }
      }

      // Update UI for all pills in this container
      document.querySelectorAll(`#${containerId} .genre-pill`).forEach(p => {
        const pVal = p.getAttribute("data-val") || "";
        const isActive = (g1.value === pVal || g2.value === pVal) && pVal !== "";
        const isNoGenre = pVal === "" && !g1.value && !g2.value;

        if (isActive || isNoGenre) {
          p.classList.add(...activeClasses);
          p.classList.remove(...inactiveClasses);
        } else {
          p.classList.remove(...activeClasses);
          p.classList.add(...inactiveClasses);
        }
      });
    };

    window.openEditTrack = (id, title, audioUrl, genre1, genre2) => {
      document.getElementById("et-track-id").value = id;
      document.getElementById("et-title").value = title;
      document.getElementById("et-old-audio").value = audioUrl;
      document.getElementById("et-genre1").value = genre1 || "";
      document.getElementById("et-genre2").value = genre2 || "";
      
      // Update UI
      const containerId = "edit-pill-container";
      document.querySelectorAll(`#${containerId} .genre-pill`).forEach(p => {
        const pVal = p.getAttribute("data-val") || "";
        const activeClasses = ["bg-gradient-to-br", "from-indigo-600", "to-indigo-400", "border-indigo-500", "text-white", "shadow-[0_8px_20px_rgba(99,102,241,0.4)]", "-translate-y-0.5"];
        const inactiveClasses = ["bg-white/5", "border-white/10", "text-slate-400"];
        
        const isActive = (genre1 === pVal || genre2 === pVal) && pVal !== "";
        const isNoGenre = pVal === "" && !genre1 && !genre2;

        if (isActive || isNoGenre) {
          p.classList.add(...activeClasses);
          p.classList.remove(...inactiveClasses);
        } else {
          p.classList.remove(...activeClasses);
          p.classList.add(...inactiveClasses);
        }
      });

      document.getElementById("edit-track-modal").classList.add("active");
    };

    window.toggleFilterGenre = (val, el) => {
      window.currentFilterGenre = (window.currentFilterGenre === val) ? "" : val;
      
      const activeClasses = ["bg-indigo-600", "text-white", "border-indigo-500", "shadow-lg", "shadow-indigo-500/20"];
      const inactiveClasses = ["bg-white/5", "text-slate-400", "border-white/10"];

      document.querySelectorAll("#genre-filter-pills .genre-filter-pill").forEach(p => {
        p.classList.remove(...activeClasses);
        p.classList.add(...inactiveClasses);
      });

      if (window.currentFilterGenre) {
        el.classList.add(...activeClasses);
        el.classList.remove(...inactiveClasses);
      } else {
        // If nothing selected, highlight "All Genres"
        const allBtn = document.querySelector(".genre-filter-pill[data-val='']");
        if (allBtn) {
          allBtn.classList.add(...activeClasses);
          allBtn.classList.remove(...inactiveClasses);
        }
      }

      window.filterTracks();
    };

    window.saveTrackEdit = async () => {
      const trackId = document.getElementById("et-track-id").value;
      const title = document.getElementById("et-title").value;
      const genre1 = document.getElementById("et-genre1").value;
      const genre2 = document.getElementById("et-genre2").value;
      const oldAudio = document.getElementById("et-old-audio").value;
      const file = document.getElementById("et-file").files[0];
      const btn = document.getElementById("et-btn");

      if (!title) return alert("Title is required.");

      btn.textContent = "Saving...";
      btn.disabled = true;

      try {
        let audioUrl = oldAudio;

        if (file) {
          const fname = `updated-t${Date.now()}.${file.name.split(".").pop()}`;
          const up = await fetch(
            `${window.SUPABASE_URL}/storage/v1/object/audio/${fname}`,
            {
              method: "POST",
              headers: {
                Authorization: `Bearer ${window.SESSION_TOKEN}`,
                apikey: window.SUPABASE_ANON_KEY,
                "Content-Type": file.type,
              },
              body: file,
            },
          );
          if (!up.ok) throw new Error("Audio upload failed");
          audioUrl = `${window.SUPABASE_URL.replace(/\/$/, "")}/storage/v1/object/public/audio/${fname}`;
        }

        const res = await fetch("/api/admin/edit-track", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ trackId, title, audio: audioUrl, genre: genre1, genre2 }),
        });

        if (res.ok) location.reload();
        else alert("Error saving track");
      } catch (e) {
        alert(e.message);
      } finally {
        btn.textContent = "Save Changes";
        btn.disabled = false;
      }
    };

