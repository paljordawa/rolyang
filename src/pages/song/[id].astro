---
import Layout from "../../layouts/Layout.astro";
import { createSupabaseServerClient } from "../../lib/supabaseServer";
import TrackTableHeader from "../../components/TrackTableHeader.astro";
import TrackRow from "../../components/TrackRow.astro";
import PlayButton from "../../components/PlayButton.astro";
import LikeButton from "../../components/LikeButton.astro";

const { id } = Astro.params;

const dummyGenres = [
  "Electronic",
  "Ambient",
  "Acoustic",
  "Pop",
  "Melodic House",
  "Chill",
  "Indie",
  "Classical",
];

let album: any = null;
let track: any = null;
let chapters: any[] = [];
let trackIndex = 0;

const supabase = createSupabaseServerClient(Astro);

if (id?.startsWith("track-")) {
  // New robust ID-based routing
  const trackIdStr = id.substring(6);

  const { data: trackData, error: trackError } = await supabase
    .from('tracks')
    .select('*')
    .match({ id: trackIdStr })
    .single();

  track = trackData;

  if (track) {
    const { data: albumData } = await supabase
      .from('albums')
      .select('*')
      .match({ id: track.album_id })
      .single();
    
    album = albumData;

    if (album) {
      const { data: tracksData } = await supabase
        .from('tracks')
        .select('*')
        .eq('album_id', album.id)
        .order('id', { ascending: true });
        
      chapters = tracksData || [];
      trackIndex = chapters.findIndex(
        (t) => t.id.toString() === track.id.toString()
      );
      if (trackIndex === -1) trackIndex = 0;
    }
  }
} else {
  // Legacy routing (albumId-trackIndex)
  const lastHyphenIndex = id?.lastIndexOf("-") ?? -1;
  const albumId = lastHyphenIndex !== -1 ? id?.substring(0, lastHyphenIndex) : id;
  const trackIndexStr = lastHyphenIndex !== -1 ? id?.substring(lastHyphenIndex + 1) : "0";
  trackIndex = parseInt(trackIndexStr || "0", 10);

  // Fetch album details
  const { data: albumData } = await supabase
    .from('albums')
    .select('*')
    .match({ id: albumId })
    .single();
    
  album = albumData;

  // Fetch all tracks for this album
  if (album) {
    const { data: tracksData } = await supabase
      .from('tracks')
      .select('*')
      .eq('album_id', album.id)
      .order('id', { ascending: true });
      
    chapters = tracksData || [];
    track = chapters[trackIndex];
  }
}

// If no album or track found, redirect to 404 early
if (!album || !track) {
  return Astro.redirect("/404");
}

const genre =
  (album as any).genre ||
  dummyGenres[Math.floor(Math.random() * dummyGenres.length)];
---

<Layout title={`${track.title} - ${(album as any).artist}`} hideNavBack={false}>
  <div class="relative min-h-screen">
    <!-- Immersive Header Background -->
    <div
      class="absolute top-0 left-0 right-0 h-[500px] -z-10 blur-[100px] opacity-40 scale-110"
      style={`background-image: url(${album.cover}); background-size: cover; background-position: center;`}
    >
    </div>
    <div
      class="absolute top-0 left-0 right-0 h-[500px] -z-20 bg-gradient-to-b from-white/10 to-[#121212]"
    >
    </div>

    <div class="pt-24 px-6 md:px-12 pb-12">
      <div
        class="flex flex-col md:flex-row items-center md:items-end gap-8 mb-12"
      >
        <!-- Massive Artwork -->
        <div
          class="w-64 h-64 md:w-80 md:h-80 shrink-0 shadow-[0_25px_60px_rgba(0,0,0,0.7)] rounded-lg overflow-hidden group relative"
        >
          <img
            src={album.cover}
            alt={album.title}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
        </div>

        <div class="flex flex-col gap-3 text-center md:text-left">
          <span
            class="text-sm font-bold uppercase tracking-[0.2em] text-white/90"
            >Song</span
          >
          <h1
            class="text-4xl md:text-8xl font-black text-white tracking-tighter leading-tight mb-4 drop-shadow-lg"
          >
            {track.title}
          </h1>
          <div
            class="flex items-center justify-center md:justify-start flex-wrap gap-2 text-base font-bold text-white"
          >
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-full overflow-hidden bg-white/10">
                <img src={album.cover} class="w-full h-full object-cover" />
              </div>
              <a
                href={`/artist/${encodeURIComponent(album.artist)}` || "#"}
                class="hover:underline transition-all active:opacity-70"
                >{album.artist}</a
              >
            </div>
            <span class="text-white/60 font-normal opacity-50">•</span>
            <a
              href={`/album/${album.id}`}
              class="text-white/80 font-semibold hover:underline"
              >{album.title}</a
            >
            <span class="text-white/60 font-normal opacity-50">•</span>
            <span class="text-white/60 font-medium">{track.duration}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Tabs Navigation -->
    <div class="flex items-center gap-8 border-b border-white/5 mb-8 pb-1">
      <button
        class="js-tab-btn px-1 py-3 text-sm font-bold border-b-2 border-[#1db954] text-white transition-all"
        data-tab="details">Details</button
      >
      <button
        class="js-tab-btn px-1 py-3 text-sm font-bold border-b-2 border-transparent text-white/60 hover:text-white transition-all"
        data-tab="lyrics">Lyrics</button
      >
      <button
        class="js-tab-btn px-1 py-3 text-sm font-bold border-b-2 border-transparent text-white/60 hover:text-white transition-all"
        data-tab="genre">Genre</button
      >
    </div>

    <!-- Tab Panels -->
    <div class="js-tab-panel" id="tab-details">
      <!-- From the Album Section -->
      <div class="max-w-4xl">
        <div
          class="flex items-center justify-between mb-6 group cursor-pointer"
          onclick={`window.appNavigate('/album/${album.id}')`}
        >
          <h2 class="text-2xl font-bold text-white group-hover:underline">
            More from {album.title}
          </h2>
          <span
            class="text-sm font-bold text-white/60 group-hover:text-white transition-colors"
            >Show all</span
          >
        </div>

        <div class="space-y-1">
          {
            chapters.slice(0, 5).map((ch, i) => (
              <div
                class={`grid grid-cols-[16px_1fr_auto_64px_32px] gap-4 px-4 py-3 rounded-md transition-all group hover:bg-white/10 items-center ${i === trackIndex ? "bg-white/10" : ""}`}
                data-player-row
                data-track-id={ch.id}
                data-track-title={ch.title}
                data-artist-name={album.artist}
                data-player-album={album.id}
                data-player-chap={i}
              >
                <div class="flex items-center justify-center relative w-4 h-4">
                  {i === trackIndex ? (
                    <div class="w-4 h-4 flex items-end gap-[2px]">
                      <div class="w-[3px] bg-[#1db954] animate-[bounce_0.8s_infinite]" />
                      <div class="w-[3px] bg-[#1db954] animate-[bounce_1s_infinite]" />
                      <div class="w-[3px] bg-[#1db954] animate-[bounce_0.6s_infinite]" />
                    </div>
                  ) : (
                    <span class="text-sm font-medium text-white/50 group-hover:opacity-0 transition-opacity">
                      {i + 1}
                    </span>
                  )}

                  <PlayButton
                    bookId={album.id.toString()}
                    chapIndex={i}
                    trackId={ch.id.toString()}
                    class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 text-white transition-opacity"
                    svgClass="w-4 h-4"
                  />
                </div>

                <div class="flex flex-col min-w-0">
                  <a
                    href={`/song/track-${ch.id}`}
                    class={`font-semibold truncate text-sm hover:underline transition-all ${i === trackIndex ? "text-[#1db954]" : "text-white"}`}
                  >
                    {ch.title}
                  </a>
                  <span class="text-[11px] text-white/50">{album.artist}</span>
                </div>

                <div class="flex items-center justify-center gap-2">
                  <button
                    type="button"
                    class="js-add-to-playlist-btn opacity-0 group-hover:opacity-100 transition-opacity focus:opacity-100 text-white/50 hover:text-white p-1"
                    data-track-id={ch.id}
                    title="Add to Playlist"
                  >
                    <svg
                      class="w-4 h-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path d="M12 5v14M5 12h14" />
                    </svg>
                  </button>
                  <div class="opacity-0 group-hover:opacity-100 transition-opacity">
                    <LikeButton
                      albumId={album.id.toString()}
                      chapId={ch.id.toString()}
                      class="p-0"
                      svgClass="w-4 h-4"
                    />
                  </div>
                </div>

                <div class="flex items-center justify-end font-medium text-xs text-white/50 tabular-nums">
                  {ch.duration || "0:00"}
                </div>

                <div class="flex items-center justify-end">
                  <button
                    type="button"
                    class="js-track-more-btn p-1 border border-white/10 rounded-md hover:bg-white/10 text-white/50 hover:text-white opacity-0 group-hover:opacity-100 transition-opacity"
                    data-track-id={ch.id}
                    data-track-title={ch.title}
                    data-artist-name={album.artist}
                    title="More"
                  >
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                      <circle cx="5" cy="12" r="1.5" />
                      <circle cx="12" cy="12" r="1.5" />
                      <circle cx="19" cy="12" r="1.5" />
                    </svg>
                  </button>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Horizontal Track Details Table -->
      <div class="mt-20 max-w-full overflow-x-auto">
        <h2 class="text-2xl font-bold text-white mb-8">Track Details</h2>

        <div class="min-w-[800px]">
          <!-- Table Header -->
          <TrackTableHeader />

          <!-- Single Data Row for the Song -->
          <div class="pt-2 pb-12">
            <TrackRow album={album} track={track} index={trackIndex} />
          </div>
        </div>
      </div>
    </div>

    <div class="js-tab-panel hidden" id="tab-lyrics">
      <div
        class="py-12 flex flex-col items-center justify-center text-center max-w-lg mx-auto"
      >
        <div
          class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mb-6"
        >
          <svg
            class="w-8 h-8 text-white/20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path
              d="M12 11h4m-4 4h4m-4-8h4M8 7h.01M8 11h.01M8 15h.01M4 4h16v16H4V4z"
            ></path></svg
          >
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Lyrics Unavailable</h3>
        <p class="text-white/40 text-sm leading-relaxed">
          We're currently working on bringing lyrics to this track. Check back
          soon for synchronized scrolling experience.
        </p>
      </div>
    </div>

    <div class="js-tab-panel hidden" id="tab-genre">
      <div class="max-w-4xl">
        <h2 class="text-2xl font-bold text-white mb-8">Genre & Tags</h2>
        <div class="flex flex-wrap gap-3">
          <div
            class="px-6 py-3 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors cursor-default"
          >
            <span
              class="text-xs font-bold text-white/40 uppercase tracking-widest block mb-1"
              >Primary Genre</span
            >
            <span class="text-xl font-black text-[#1db954]">{genre}</span>
          </div>
          {
            ["Melodic House", "Chillout", "Instrumental"].map((tag) => (
              <div class="px-6 py-3 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors cursor-default flex flex-col justify-end">
                <span class="text-base font-bold text-white">{tag}</span>
              </div>
            ))
          }
        </div>

        <div
          class="mt-12 p-8 rounded-2xl bg-gradient-to-br from-white/5 to-transparent border border-white/10"
        >
          <h4 class="text-lg font-bold text-white mb-4">About this genre</h4>
          <p class="text-white/60 text-sm leading-relaxed md:w-2/3">
            {genre} often features atmospheric arrangements, emotive melodies, and
            organic textures. It is designed to create an immersive listening environment,
            perfect for focusing or relaxing.
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Tab switching logic
    function setupTabs() {
      const btns = document.querySelectorAll(".js-tab-btn");
      const panels = document.querySelectorAll(".js-tab-panel");

      btns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-tab");

          // Update buttons
          btns.forEach((b) => {
            b.classList.remove("border-[#1db954]", "text-white");
            b.classList.add("border-transparent", "text-white/60");
          });
          btn.classList.add("border-[#1db954]", "text-white");
          btn.classList.remove("border-transparent", "text-white/60");

          // Update panels
          panels.forEach((p) => p.classList.add("hidden"));
          const activePanel = document.getElementById(`tab-${target}`);
          if (activePanel) activePanel.classList.remove("hidden");
        });
      });
    }

    // Initialize on load and on navigation
    setupTabs();
    window.addEventListener("app:navigation", setupTabs);
  </script>
</Layout>
