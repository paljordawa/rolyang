---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Search">
  <div class="px-4 pt-6 md:pt-10 max-w-7xl mx-auto">
    <div class="sticky top-0 z-20 bg-[#121212] pb-6 pt-2">
      <div class="relative max-w-lg">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-5 h-5 text-gray-400"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </div>
        <input 
          type="text" 
          id="search-input"
          placeholder="What do you want to listen to?" 
          class="w-full h-12 bg-white/10 hover:bg-white/20 border-none rounded-full pl-12 pr-4 text-white text-sm font-semibold placeholder:text-gray-400 focus:bg-[#282828] focus:ring-2 focus:ring-white transition-all outline-none"
        />
      </div>
    </div>

    <!-- Search Results View -->
    <div id="search-results-container" class="hidden space-y-10 mb-20">
      
      <!-- Songs Section -->
      <section id="section-songs" class="hidden">
        <h2 class="text-2xl font-bold text-white mb-4">Songs</h2>
        <div id="results-songs" class="space-y-1">
          <!-- Song rows -->
        </div>
      </section>

      <!-- Playlists Section -->
      <section id="section-playlists" class="hidden">
        <h2 class="text-2xl font-bold text-white mb-4">Playlists</h2>
        <div id="results-playlists" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
          <!-- Playlist cards -->
        </div>
      </section>

      <!-- Artists Section -->
      <section id="section-artists" class="hidden">
        <h2 class="text-2xl font-bold text-white mb-4">Artists</h2>
        <div id="results-artists" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
          <!-- Artist cards -->
        </div>
      </section>

      <!-- Albums Section -->
      <section id="section-albums" class="hidden">
        <h2 class="text-2xl font-bold text-white mb-4">Albums</h2>
        <div id="results-albums" class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
          <!-- Album cards -->
        </div>
      </section>

      <div id="no-results" class="hidden text-center py-20">
        <h3 class="text-xl font-bold text-white mb-2">No results found for "<span id="query-string"></span>"</h3>
        <p class="text-white/60">Please make sure your words are spelled correctly, or use fewer or different keywords.</p>
      </div>

    </div>

    <!-- Default Browse View -->
    <div id="search-browse-all">
      <h2 class="text-2xl font-bold text-white mb-6">Browse all</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4">
        {[
          { title: 'Podcasts', color: 'bg-[#e8115b]' },
          { title: 'Live Events', color: 'bg-[#8d67ab]' },
          { title: 'Made For You', color: 'bg-[#1e3264]' },
          { title: 'New Releases', color: 'bg-[#e91429]' },
          { title: 'Pop', color: 'bg-[#27856a]' },
          { title: 'Hip-Hop', color: 'bg-[#bc5900]' },
          { title: 'Rock', color: 'bg-[#e11a22]' },
          { title: 'Latin', color: 'bg-[#e1118c]' },
          { title: 'Charts', color: 'bg-[#8d67ab]' },
          { title: 'Educational', color: 'bg-[#503750]' },
        ].map((cat) => (
          <div class={`${cat.color} aspect-square rounded-lg p-4 relative overflow-hidden group cursor-pointer hover:scale-105 transition-transform duration-300`}>
            <span class="text-xl font-bold text-white break-words">{cat.title}</span>
            <div class="absolute -right-4 -bottom-4 w-24 h-24 rotate-[25deg] shadow-lg group-hover:scale-110 transition-transform">
               <div class="w-full h-full bg-white/20 rounded-md ring-1 ring-white/10 flex items-center justify-center p-2">
                 <img src="https://i.scdn.co/image/ab67706f00000002b6623631627993077af2c6f1" class="w-full h-full object-cover" alt="" />
               </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  import { $likedTracks } from '../store/playerStore';
  let debounceTimer: any;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsContainer = document.getElementById('search-results-container');
  const browseAll = document.getElementById('search-browse-all');
  
  const sections = {
    songs: { 
      el: document.getElementById('section-songs'), 
      grid: document.getElementById('results-songs') 
    },
    playlists: { 
      el: document.getElementById('section-playlists'), 
      grid: document.getElementById('results-playlists') 
    },
    artists: { 
      el: document.getElementById('section-artists'), 
      grid: document.getElementById('results-artists') 
    },
    albums: { 
      el: document.getElementById('section-albums'), 
      grid: document.getElementById('results-albums') 
    }
  };

  const noResults = document.getElementById('no-results');
  const queryString = document.getElementById('query-string');

  if (input && resultsContainer && browseAll) {
    input.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      const query = (e.target as HTMLInputElement).value.trim();
      
      if (query === '') {
        resultsContainer.classList.add('hidden');
        browseAll.classList.remove('hidden');
        return;
      }

      debounceTimer = setTimeout(async () => {
        try {
          browseAll.classList.add('hidden');
          resultsContainer.classList.remove('hidden');
          
          // Clear current
          Object.values(sections).forEach(s => {
            if (s.grid) s.grid.innerHTML = '';
            s.el?.classList.add('hidden');
          });
          noResults?.classList.add('hidden');

          const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
          const data = await res.json();
          
          let hasAny = false;

          // Render Songs
          if (data.songs?.length > 0) {
            hasAny = true;
            sections.songs.el?.classList.remove('hidden');
            if (sections.songs.grid) {
              sections.songs.grid.innerHTML = data.songs.map((song: any) => `
                <div 
                  class="flex items-center gap-4 p-2 rounded-md hover:bg-white/10 group transition-colors cursor-pointer" 
                  data-play-song='${JSON.stringify({bookId: song.album_id, chapIndex: song.trackIndex})}'
                >
                  <div class="w-10 h-10 shrink-0 relative overflow-hidden rounded bg-white/5 shadow-md">
                    <img src="${song.albumCover}" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity">
                      <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-white"><path d="M5.25 5.036a.75.75 0 0 1 1.125-.66l12 7a.75.75 0 0 1 0 1.287l-12 7A.75.75 0 0 1 5.25 19.964V5.036z" /></svg>
                    </div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <a href="/song/${song.album_id}-${song.trackIndex}" class="font-bold text-white truncate text-sm md:text-base leading-tight hover:underline transition-all block max-w-fit">${song.title}</a>
                    <div class="flex items-center gap-1.5 text-[13px] text-white/60 truncate mt-1">
                       <span class="hover:underline hover:text-white transition-colors cursor-pointer" data-nav-artist="${song.albumArtist}">${song.albumArtist}</span>
                       <span class="text-white/30">•</span>
                       <span class="hover:underline hover:text-white transition-colors cursor-pointer" data-nav-album="${song.album_id}">${song.albumTitle}</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-4 px-2 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
                    <button 
                      class="js-add-to-playlist-btn text-white/50 hover:text-white transition p-1" 
                      data-track-id="${song.id}"
                      title="Add to Playlist"
                    >
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                    </button>
                    <button class="js-like-btn text-white/50 hover:text-white transition p-1" data-album-id="${song.album_id}" data-chap-id="${song.id}">
                      <svg class="w-4 h-4 empty-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                      <svg class="w-4 h-4 filled-heart text-[#1db954] hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"></path></svg>
                    </button>
                    <div class="text-[13px] text-white/50 tabular-nums">${song.duration || '0:00'}</div>
                  </div>
                </div>
              `).join('');
            }
          }

          // Render Playlists
          if (data.playlists?.length > 0) {
            hasAny = true;
            sections.playlists.el?.classList.remove('hidden');
            if (sections.playlists.grid) {
              sections.playlists.grid.innerHTML = data.playlists.map((pl: any) => `
                <div 
                  class="flex flex-col p-4 bg-[#181818] hover:bg-[#282828] transition-all duration-300 rounded-lg group cursor-pointer"
                  data-nav-playlist="${pl.id}"
                >
                  <div class="aspect-square w-full mb-4 relative shadow-[0_8px_24px_rgba(0,0,0,0.5)] rounded-md overflow-hidden ${pl.isLikedSongs ? 'bg-gradient-to-br from-[#450af5] to-[#8e8ee5] flex items-center justify-center' : 'bg-white/5'}">
                    ${pl.isLikedSongs ? `
                      <svg class="w-1/2 h-1/2 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"></path></svg>
                    ` : `
                      <img src="${pl.cover}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    `}
                    <button class="absolute right-3 bottom-3 w-12 h-12 rounded-full bg-[#1db954] flex items-center justify-center text-black shadow-xl opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 hover:scale-105">
                      <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 ml-1"><path d="M5.25 5.036a.75.75 0 0 1 1.125-.66l12 7a.75.75 0 0 1 0 1.287l-12 7A.75.75 0 0 1 5.25 19.964V5.036z" /></svg>
                    </button>
                  </div>
                  <div class="font-bold text-base truncate text-white mb-1 group-hover:underline">${pl.title}</div>
                  <div class="text-sm text-white/70 truncate">${pl.artist}</div>
                </div>
              `).join('');
            }
          }

          // Render Artists
          if (data.artists?.length > 0) {
            hasAny = true;
            sections.artists.el?.classList.remove('hidden');
            if (sections.artists.grid) {
              sections.artists.grid.innerHTML = data.artists.map((artist: any) => `
                <a href="/artist/${encodeURIComponent(artist.artist)}" class="flex flex-col p-4 bg-[#181818] hover:bg-[#282828] transition-all duration-300 rounded-lg group cursor-pointer border border-transparent">
                  <div class="aspect-square w-full mb-4 relative shadow-[0_8px_24px_rgba(0,0,0,0.5)] rounded-full overflow-hidden">
                    <img src="${artist.cover}" alt="${artist.artist}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  </div>
                  <div class="font-bold text-base truncate text-white mb-1 group-hover:underline">${artist.artist}</div>
                  <div class="text-sm text-white/70 uppercase tracking-wider text-[10px]">Artist</div>
                </a>
              `).join('');
            }
          }

          // Render Albums
          if (data.albums?.length > 0) {
            hasAny = true;
            sections.albums.el?.classList.remove('hidden');
            if (sections.albums.grid) {
              sections.albums.grid.innerHTML = data.albums.map((album: any) => `
                <a href="/album/${album.id}" class="flex flex-col p-4 bg-[#181818] hover:bg-[#282828] transition-all duration-300 rounded-lg group cursor-pointer">
                  <div class="aspect-square w-full mb-4 relative shadow-[0_8px_24px_rgba(0,0,0,0.5)] rounded-md overflow-hidden">
                    <img src="${album.cover}" alt="${album.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <button class="absolute right-3 bottom-3 w-12 h-12 rounded-full bg-[#1db954] flex items-center justify-center text-black shadow-xl opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 hover:scale-105">
                      <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 ml-1"><path d="M5.25 5.036a.75.75 0 0 1 1.125-.66l12 7a.75.75 0 0 1 0 1.287l-12 7A.75.75 0 0 1 5.25 19.964V5.036z" /></svg>
                    </button>
                  </div>
                  <div class="font-bold text-base truncate text-white mb-1 group-hover:underline">${album.title}</div>
                  <div class="text-sm text-white/70 truncate">${album.artist}</div>
                </a>
              `).join('');
            }
          }

          if (!hasAny) {
            noResults?.classList.remove('hidden');
            if (queryString) queryString.textContent = query;
          }
          
          // Sync liked states immediately for newly rendered results
          const likes = $likedTracks.get();
          document.querySelectorAll('.js-like-btn').forEach((btn: any) => {
            const albumId = btn.getAttribute('data-album-id');
            const chapId = btn.getAttribute('data-chap-id');
            const isLiked = !!likes[`${albumId}:${chapId}`];
            const empty = btn.querySelector('.empty-heart');
            const filled = btn.querySelector('.filled-heart');
            if (isLiked) {
              empty?.classList.add('hidden');
              filled?.classList.remove('hidden');
            } else {
              empty?.classList.remove('hidden');
              filled?.classList.add('hidden');
            }
          });

          // Wire up playback for songs
          document.querySelectorAll('[data-play-song]').forEach(el => {
            el.addEventListener('click', (e) => {
              if ((e.target as HTMLElement).closest('button') || (e.target as HTMLElement).closest('span[data-nav-album]') || (e.target as HTMLElement).closest('span[data-nav-artist]')) return;
              const data = JSON.parse(el.getAttribute('data-play-song') || '{}');
              // @ts-ignore
              if (window.playerPlay) window.playerPlay({ bookId: data.bookId, chapIndex: data.chapIndex });
            });
          });

          // Wire up navigation for metadata
          document.querySelectorAll('[data-nav-album]').forEach(el => {
            el.addEventListener('click', () => {
              const albumId = el.getAttribute('data-nav-album');
              // @ts-ignore
              if (window.appNavigate) window.appNavigate(`/album/${albumId}`);
            });
          });

          document.querySelectorAll('[data-nav-artist]').forEach(el => {
            el.addEventListener('click', () => {
              const name = el.getAttribute('data-nav-artist');
              // @ts-ignore
              if (window.appNavigate) window.appNavigate(`/artist/${encodeURIComponent(name)}`);
            });
          });

          document.querySelectorAll('[data-nav-playlist]').forEach(el => {
            el.addEventListener('click', () => {
              const plId = el.getAttribute('data-nav-playlist');
              if (plId === 'liked-songs') {
                // @ts-ignore
                if (window.appNavigate) window.appNavigate('/collection/tracks');
              } else {
                // Handle generic playlists later
              }
            });
          });

        } catch (err) {
          console.error('Search failed:', err);
        }
      }, 400);
    });
  }
</script>
