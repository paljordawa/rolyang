---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabaseServer';
import SkeletonAlbum from '../components/SkeletonAlbum.astro';
import AlbumCard from '../components/AlbumCard.astro';

const supabase = createSupabaseServerClient(Astro);
const { data: albums = [], error } = await supabase
  .from('albums')
  .select('*');

if (error) {
  console.error("Library fetch error:", error);
}

// Mocking different sections using subsets of albums
const playlists = albums.slice(0, 5);
const madeForYou = albums;
const genres = albums.slice(5, 10);
---
<Layout title="Your Library">
  <div class="px-2.5 pt-3 md:pt-10 max-w-[1600px] mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl lg:text-4xl font-black text-white tracking-tight leading-tight drop-shadow-2xl font-heading">Your Library</h1>
    </div>

    {albums.length === 0 ? (
      <SkeletonAlbum count={6} />
    ) : (
      <div class="space-y-12 pb-20">
        
        <!-- Playlists Section -->
        <section>
          <div class="flex items-center justify-between mb-5">
            <h2 class="font-heading font-bold text-2xl hover:text-brand-primary transition-colors cursor-pointer text-white">Playlists</h2>
          </div>
          <div class="flex overflow-x-auto gap-3 pb-6 no-scrollbar -mx-4 px-4 snap-x">
            {playlists.map((album) => (
              <div class="w-32 md:w-40 shrink-0 snap-start">
                <AlbumCard 
                  id={album.id as string} 
                  title={album.title as string} 
                  artist={album.artist as string} 
                  cover={album.cover as string} 
                  width="auto"
                />
              </div>
            ))}
          </div>
        </section>

        <!-- Made for you Section -->
        <section>
          <div class="flex items-center justify-between mb-5">
            <h2 class="font-heading font-bold text-2xl hover:text-brand-primary transition-colors cursor-pointer text-white">Made for you</h2>
          </div>
          <div class="flex overflow-x-auto gap-3 pb-6 no-scrollbar -mx-4 px-4 snap-x">
            {madeForYou.map((album) => (
              <div class="w-32 md:w-40 shrink-0 snap-start">
                <AlbumCard 
                  id={album.id as string} 
                  title={album.title as string} 
                  artist={album.artist as string} 
                  cover={album.cover as string} 
                  width="auto"
                />
              </div>
            ))}
          </div>
        </section>

        <!-- Genre Section -->
        <section>
          <div class="flex items-center justify-between mb-5">
            <h2 class="font-heading font-bold text-2xl hover:text-brand-primary transition-colors cursor-pointer text-white">Genres</h2>
          </div>
          <div class="flex overflow-x-auto gap-3 pb-6 no-scrollbar -mx-4 px-4 snap-x">
            {genres.map((album) => (
              <div class="w-32 md:w-40 shrink-0 snap-start">
                <AlbumCard 
                  id={album.id as string} 
                  title={album.title as string} 
                  artist={album.artist as string} 
                  cover={album.cover as string} 
                  width="auto"
                />
              </div>
            ))}
          </div>
        </section>

      </div>
    )}
  </div>
</Layout>
