---
import Layout from '../../layouts/Layout.astro';
import TrackTableHeader from '../../components/TrackTableHeader.astro';
import TrackRow from '../../components/TrackRow.astro';
import PlayButton from '../../components/PlayButton.astro';
import { createSupabaseServerClient } from '../../lib/supabaseServer';

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');

const supabase = createSupabaseServerClient(Astro);

// 1. Get playlist details from Supabase
const { data: playlist } = await supabase
  .from('playlists')
  .select('*')
  .eq('id', id)
  .single();

let playlistTracks = [];

if (playlist) {
  // 2. Get tracks in this playlist
  const { data: tracksRes } = await supabase
    .from('playlist_tracks')
    .select('added_at, tracks(*, albums(title, artist, cover))')
    .eq('playlist_id', id)
    .order('added_at', { ascending: true });

  if (tracksRes) {
    playlistTracks = tracksRes.map(pt => ({
      ...pt.tracks,
      album_title: pt.tracks.albums?.title,
      album_artist: pt.tracks.albums?.artist,
      album_cover: pt.tracks.albums?.cover,
      added_at: pt.added_at
    }));
  }
}
---

<Layout backHref="/library">
  {playlist ? (
    <div class="relative min-h-screen">
      <!-- Header with Playlist Info -->
      <div class="pt-12 px-2 md:px-12 pb-12 bg-gradient-to-b from-[#450af5]/20 to-[#121212]">
        <div class="flex flex-col md:flex-row items-center md:items-end gap-8 mb-12">
          <!-- Artwork -->
          <div class="w-64 h-64 md:w-[232px] md:h-[232px] shrink-0 shadow-[0_25px_60px_rgba(0,0,0,0.7)] rounded-md overflow-hidden group relative">
             <div class="absolute inset-0 bg-gradient-to-br from-[#450af5] to-[#8e8ee5] flex items-center justify-center">
                <svg class="w-1/2 h-1/2 text-white/50" viewBox="0 0 24 24" fill="currentColor"><path d="M12 5v14M5 12h14"/></svg>
             </div>
             {(!playlistTracks[0]?.album_cover && playlist.cover && playlist.cover !== 'gradient') && (
                <img src={playlist.cover} class="w-full h-full object-cover relative z-10" />
             )}
             {playlistTracks[0]?.album_cover && (
                <img src={playlistTracks[0].album_cover} class="w-full h-full object-cover relative z-10" />
             )}
          </div>
          
          <div class="flex flex-col gap-3 text-center md:text-left flex-1">
            <span class="text-sm font-bold uppercase tracking-[0.2em] text-white/90">Playlist</span>
            <h1 class="text-4xl md:text-7xl font-black text-white tracking-tighter leading-tight mb-2 drop-shadow-lg">
              {String(playlist.title)}
            </h1>
            {playlist.description && (
              <p data-playlist-description class="text-white/60 text-sm md:text-base font-medium mb-4 line-clamp-2 max-w-2xl">{playlist.description}</p>
            )}
            <div class="flex items-center justify-center md:justify-start flex-wrap gap-2 text-sm font-bold text-white/60">
               <span class="text-white hover:underline cursor-pointer">User</span>
               <span>•</span>
               <span data-playlist-track-count>{playlistTracks.length} tracks</span>
            </div>
          </div>
        </div>

        <!-- Sticky Actions Bar -->
        <div class="flex items-center justify-between py-4 mb-8">
          <div class="flex items-center gap-6 md:gap-8">
            <PlayButton 
              bookId={`playlist-${playlist.id}`}
              chapIndex={0}
              trackId={playlistTracks[0]?.id?.toString()}
              class="w-14 h-14 rounded-full bg-[#1db954] flex items-center justify-center text-black shadow-xl hover:scale-105 active:scale-95 transition-all"
              svgClass="w-8 h-8 ml-1"
            />
            <div class="flex items-center gap-4">
              <button 
                id="edit-playlist-btn" 
                class="px-4 py-2 text-xs font-bold uppercase tracking-wider text-white/70 border border-white/20 rounded-sm hover:bg-white/10 hover:text-white transition-all"
                data-playlist-id={playlist.id}
                data-playlist-title={playlist.title}
                data-playlist-description={playlist.description}
              >
                Edit Details
              </button>
              <button id="delete-playlist-btn" class="text-white/40 hover:text-white transition-colors" title="Delete Playlist">
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Track Table -->
        <div class="mb-52">
          <TrackTableHeader />
          <div class="space-y-1">
            {playlistTracks.map((track, i) => (
              <TrackRow 
                index={i}
                track={track} 
                album={{ 
                    id: `playlist-${playlist.id}`, // Makes the row talk to the player as part of the playlist
                    title: track.album_title, 
                    artist: track.album_artist, 
                    cover: track.album_cover 
                }} 
              />
            ))}
            {playlistTracks.length === 0 && (
              <div class="py-20 text-center text-white/40 italic">
                This playlist is currently empty. Add tracks from any album!
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="text-center text-white/80 py-20 px-6">
      <h2 class="text-2xl font-bold mb-2">Playlist not found</h2>
      <p>Please check the URL or go back to your library.</p>
    </div>
  )}

  <script is:inline define:vars={{ playlistId: id }}>
    // Delete logic
    document.getElementById('delete-playlist-btn')?.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to delete this playlist?')) return;
      
      try {
        const res = await fetch(`/api/library/playlists/${playlistId}`, { method: 'DELETE' });
        if (res.ok) {
          // Update global state if we can, but simpler to just reload/navigate
          window.location.href = '/library'; 
        }
      } catch (e) {
        console.error('Failed to delete playlist:', e);
      }
    });

    // Edit logic
    document.getElementById('edit-playlist-btn')?.addEventListener('click', (e) => {
      const btn = e.currentTarget;
      // @ts-ignore
      if (window.openEditPlaylistModal) {
          // @ts-ignore
          window.openEditPlaylistModal({
              id: btn.getAttribute('data-playlist-id'),
              title: btn.getAttribute('data-playlist-title'),
              description: btn.getAttribute('data-playlist-description')
          });
      }
    });


    // Handle view transitions / dynamic nav
    document.addEventListener('app:navigation', () => {
        // Re-run any needed init logic
    });
  </script>
</Layout>
