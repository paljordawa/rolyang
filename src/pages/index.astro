---
import Layout from '../layouts/Layout.astro';
import { createSupabaseServerClient } from '../lib/supabaseServer';
import SkeletonAlbum from '../components/SkeletonAlbum.astro';
import AlbumCard from '../components/AlbumCard.astro';
import CompactAlbumCard from '../components/CompactAlbumCard.astro';
import PlayButton from '../components/PlayButton.astro';

const supabase = createSupabaseServerClient(Astro);
// Parallelize auth and data fetching
const [{ data: authData }, { data: albumsResult, error }] = await Promise.all([
  supabase.auth.getUser(),
  supabase.from('albums')
    .select('id, title, artist, cover')
    .limit(12)
]);
const albums = albumsResult || [];
const user = authData?.user;

console.log('DEBUG index.astro: albums found:', albums.length);
if (error) console.error('DEBUG index.astro: error fetching albums:', error);

// Protect the entire application
if (!user) {
  return Astro.redirect('/login');
}

if (error) {
  console.error("Supabase error:", error);
}

const time = new Date().getHours();
let greeting = 'Good evening';
if (time < 12) greeting = 'Good morning';
else if (time < 18) greeting = 'Good afternoon';
---
<Layout hidePlayerUntilPlaying>
  <!-- Background Gradient for Home -->
  <div class="absolute inset-x-0 top-0 bg-gradient-to-b from-brand-primary/20 via-brand-secondary/5 to-transparent h-[500px] pointer-events-none -z-10 transition-colors duration-500 blur-3xl opacity-50"></div>
  
  <div class="px-2 pt-1 md:pt-4 relative z-10">
    <h1 class="page-title text-3xl sm:text-4xl font-heading font-extrabold mb-8 text-white tracking-tight">{greeting}</h1>
    
    <!-- Top Grid (6 items) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
      {[...albums, ...albums].slice(0,6).map(album => (
        <a 
          href={`/album/${album.id as string}`}
          class="flex items-center bg-white/5 hover:bg-white/10 border border-white/5 transition-all duration-300 rounded-md overflow-hidden group cursor-pointer backdrop-blur-md" 
        >
          <img src={album.cover as string} alt={album.title as string} class="w-16 h-16 md:w-20 md:h-20 object-cover shadow-2xl transition-transform duration-700 group-hover:scale-110" />
          <div class="px-4 flex-1 font-bold text-sm md:text-base truncate text-white">{album.title}</div>
          <div class="pr-3 opacity-0 group-hover:opacity-100 transition-all transform translate-x-2 group-hover:translate-x-0 flex items-center justify-center">
            <PlayButton 
              bookId={album.id ? album.id.toString() : ""} 
              chapIndex={0} 
              class="w-12 h-12 rounded-full bg-gradient-to-br from-brand-primary to-brand-secondary flex items-center justify-center text-white shadow-[0_8px_20px_rgba(99,102,241,0.5)] hover:scale-110 transition-all" 
              svgClass="w-6 h-6 ml-1"
            />
          </div>
        </a>
      ))}
    </div>

    <!-- Made For You Row -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-heading font-bold text-2xl hover:text-brand-primary transition-colors cursor-pointer text-white">Made for you</h2>
        <a href="/library" class="text-sm text-white/70 font-semibold hover:underline">Show all</a>
      </div>
      {albums.length === 0 ? (
      <SkeletonAlbum count={6} />
    ) : (
      <div class="flex overflow-x-auto gap-5 pb-6 no-scrollbar -mx-4 px-4 snap-x">
        {albums.map((album) => (
          <div class="w-44 md:w-52 shrink-0 snap-start">
            <AlbumCard 
              id={album.id as string} 
              title={album.title as string} 
              artist={album.artist as string} 
              cover={album.cover as string} 
              width="auto"
            />
          </div>
        ))}
      </div>
    )}
    </section>

    <!-- Recently Played Section (Compact Horizontal Grid) -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-5">
        <h2 class="font-heading font-bold text-2xl hover:text-brand-primary transition-colors cursor-pointer text-white">Recently played</h2>
        <a href="/library" class="text-xs text-brand-primary font-bold uppercase tracking-[0.2em] hover:text-brand-accent transition-colors">Show all</a>
      </div>
      
      <div class="flex overflow-x-auto gap-4 pb-6 no-scrollbar -mx-4 px-4 snap-x">
        {[...albums].reverse().slice(0, 8).map(album => (
          <div class="w-72 md:w-80 shrink-0 snap-start">
            <CompactAlbumCard 
              id={album.id as string} 
              title={album.title as string} 
              artist={album.artist as string} 
              cover={album.cover as string}
            />
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
