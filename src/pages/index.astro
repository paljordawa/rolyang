---
import Layout from '../layouts/Layout.astro';
import { client } from '../lib/db';
import SkeletonAlbum from '../components/SkeletonAlbum.astro';
import AlbumCard from '../components/AlbumCard.astro';
import CompactAlbumCard from '../components/CompactAlbumCard.astro';
import LikeButton from '../components/LikeButton.astro';
import PlayButton from '../components/PlayButton.astro';

const albumsResult = await client.execute("SELECT * FROM albums LIMIT 12");
const albums = albumsResult.rows;

const time = new Date().getHours();
let greeting = 'Good evening';
if (time < 12) greeting = 'Good morning';
else if (time < 18) greeting = 'Good afternoon';
---
<Layout hidePlayerUntilPlaying>
  <!-- Background Gradient for Home -->
  <div class="absolute inset-0 bg-gradient-to-b from-purple-900/30 to-[#121212] h-80 pointer-events-none -z-10 transition-colors duration-500"></div>
  
  <div class="px-2 pt-1 md:pt-4 relative z-10">
    <h1 class="page-title text-2xl sm:text-3xl font-bold mb-6 text-white">{greeting}</h1>
    
    <!-- Top Grid (6 items) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
      {[...albums, ...albums].slice(0,6).map(album => (
        <a 
          href={`/album/${album.id as string}`}
          class="flex items-center bg-white/5 hover:bg-white/20 transition-colors rounded-md overflow-hidden group cursor-pointer" 
        >
          <img src={album.cover as string} alt={album.title as string} class="w-14 h-14 object-cover shadow-[0_4px_10px_rgba(0,0,0,0.3)]" />
          <div class="px-3 flex-1 font-bold text-sm truncate text-white">{album.title}</div>
          <div class="pr-3 opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-2">
            <PlayButton 
              bookId={album.id ? album.id.toString() : ""} 
              chapIndex={0} 
              class="w-10 h-10 rounded-full bg-[#1db954] flex items-center justify-center text-black shadow-[0_8px_8px_rgba(0,0,0,0.3)] hover:scale-105 hover:bg-[#1ed760] transition-all" 
            />
          </div>
        </a>
      ))}
    </div>

    <!-- Made For You Row -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-2xl hover:underline cursor-pointer text-white">Made for you</h2>
        <a href="/library" class="text-sm text-white/70 font-semibold hover:underline">Show all</a>
      </div>
      {albums.length === 0 ? (
      <SkeletonAlbum count={6} />
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
        {albums.map((album) => (
          <AlbumCard 
            id={album.id as string} 
            title={album.title as string} 
            artist={album.artist as string} 
            cover={album.cover as string} 
            width="auto"
          />
        ))}
      </div>
    )}
    </section>

    <!-- Recently Played Section (Compact Horizontal Grid) -->
    <section class="mb-14">
      <div class="flex items-center justify-between mb-5">
        <h2 class="font-bold text-2xl hover:underline cursor-pointer text-white">Recently played</h2>
        <a href="/library" class="text-sm text-white/50 font-bold uppercase tracking-widest hover:text-white transition-colors">Show all</a>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4 pb-4">
        {[...albums].reverse().slice(0, 6).map(album => (
          <CompactAlbumCard 
            id={album.id as string} 
            title={album.title as string} 
            artist={album.artist as string} 
            cover={album.cover as string}
          />
        ))}
      </div>
    </section>
  </div>
</Layout>
