---
import { createSupabaseServerClient } from "../lib/supabaseServer";
import { ClientRouter } from "astro:transitions";
import "../styles.css";

const supabase = createSupabaseServerClient(Astro);
const {
  data: { user },
} = await supabase.auth.getUser();

if (user) {
  return Astro.redirect("/");
}

const errorObj = Astro.url.searchParams.get("error");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Login | Rolyang</title>
    <ClientRouter />
  </head>
  <body
    class="bg-[#000000] text-white h-screen flex flex-col items-center justify-center font-sans overflow-hidden relative"
  >
    <!-- Immersive background glow -->
    <div
      class="absolute w-[800px] h-[800px] bg-[#450af5] rounded-full blur-[150px] opacity-20 -z-10 pointer-events-none center-glow-anim"
    >
    </div>

    <div class="w-full max-w-sm px-6 relative z-10 flex flex-col items-center">
      <!-- Logo with pulse/scale and fade-in animation -->
      <div class="mb-12 animate-logo-reveal flex flex-col items-center relative">
        <img
          src="/rolyang-logo.svg"
          alt="Rolyang Logo"
          class="w-32 h-32 md:w-40 md:h-40 animate-colorful-logo drop-shadow-2xl"
        />
        <h1
          class="text-4xl md:text-5xl text-white tracking-tighter drop-shadow-lg mt-4"
        >
          Rolyang
        </h1>
      </div>

      <!-- Rest of the content fades in AFTER the logo -->
      <div
        class="w-full animate-content-reveal opacity-0"
        style="animation-fill-mode: forwards;"
      >
        <p class="text-white/60 text-center mb-10 text-sm font-medium">
          Discover and listen to your favorite audiobooks instantly.
        </p>

        {
          errorObj && (
            <div class="bg-red-500/10 border border-red-500/50 text-red-500 text-sm p-3 rounded-lg text-center mb-6 font-semibold">
              {errorObj}
            </div>
          )
        }

        <div class="space-y-4">
          <button
            id="google-login"
            class="w-full flex items-center justify-center gap-3 bg-white text-black font-bold py-3.5 px-6 rounded-full hover:scale-105 active:scale-95 shadow-[0_4px_12px_rgba(255,255,255,0.1)] transition-transform duration-300"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <path
                fill="currentColor"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              ></path>
              <path
                fill="currentColor"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              ></path>
              <path
                fill="currentColor"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
              ></path>
              <path
                fill="currentColor"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.66l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 12-4.53z"
              ></path>
            </svg>
            Continue with Google
          </button>

          <button
            id="facebook-login"
            class="w-full flex items-center justify-center gap-3 bg-[#1877F2] text-white font-bold py-3.5 px-6 rounded-full hover:scale-105 active:scale-95 shadow-[0_4px_12px_rgba(24,119,242,0.3)] transition-transform duration-300"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.791-4.667 4.529-4.667 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path>
            </svg>
            Continue with Facebook
          </button>
        </div>

        <div class="mt-12 pt-6 text-center">
          <p class="text-[11px] text-white/30 font-medium">
            By continuing, you agree to Rolyang's Terms of Service and Privacy
            Policy.
          </p>
        </div>
      </div>
    </div>

    <style>
      @keyframes logoReveal {
        0% {
          opacity: 0;
          transform: scale(0.6) translateY(20px);
        }
        50% {
          opacity: 1;
          transform: scale(1.05) translateY(0);
        }
        100% {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      @keyframes contentReveal {
        0% {
          opacity: 0;
          transform: translateY(20px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes glowPulse {
        0% {
          transform: scale(0.8);
          opacity: 0.1;
        }
        50% {
          transform: scale(1.2);
          opacity: 0.3;
        }
        100% {
          transform: scale(0.8);
          opacity: 0.1;
        }
      }
      
      @keyframes colorfulFloat {
        0% { filter: drop-shadow(0 0 15px rgba(255, 0, 128, 0.6)) drop-shadow(0 0 40px rgba(255, 0, 128, 0.3)); transform: translateY(0px) rotate(0deg); }
        33% { filter: drop-shadow(0 0 15px rgba(0, 255, 255, 0.6)) drop-shadow(0 0 40px rgba(0, 255, 255, 0.3)); transform: translateY(-8px) rotate(3deg); }
        66% { filter: drop-shadow(0 0 15px rgba(128, 0, 255, 0.6)) drop-shadow(0 0 40px rgba(128, 0, 255, 0.3)); transform: translateY(4px) rotate(-3deg); }
        100% { filter: drop-shadow(0 0 15px rgba(255, 0, 128, 0.6)) drop-shadow(0 0 40px rgba(255, 0, 128, 0.3)); transform: translateY(0px) rotate(0deg); }
      }

      .animate-logo-reveal {
        animation: logoReveal 1.2s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
      }
      
      .animate-colorful-logo {
        animation: colorfulFloat 6s ease-in-out infinite;
      }

      .animate-content-reveal {
        animation: contentReveal 0.8s ease-out 1.2s forwards;
      }

      .center-glow-anim {
        animation: glowPulse 8s infinite ease-in-out;
      }
    </style>

    <script>
      import { supabase } from "../lib/supabase";

      const googleBtn = document.getElementById("google-login");
      const facebookBtn = document.getElementById("facebook-login");

      googleBtn?.addEventListener("click", async () => {
        await supabase.auth.signInWithOAuth({
          provider: "google",
          options: {
            redirectTo: window.location.origin + "/auth/callback",
          },
        });
      });

      facebookBtn?.addEventListener("click", async () => {
        await supabase.auth.signInWithOAuth({
          provider: "facebook",
          options: {
            redirectTo: window.location.origin + "/auth/callback",
          },
        });
      });
    </script>
  </body>
</html>
