---
import PlayButton from './PlayButton.astro';
import LikeButton from './LikeButton.astro';

export interface Props {
  id: string | number;
  title: string;
  artist: string;
  cover: string;
  width?: "full" | "auto" | "fixed";
  showLike?: boolean;
}
const { id, title, artist, cover, width = "full", showLike = true } = Astro.props;
---
<a 
  href={`/album/${id}`}
  class={`flex flex-col p-4 bg-[#181818] hover:bg-[#282828] transition-all duration-300 rounded-lg group cursor-pointer relative ${width === 'fixed' ? 'w-36 md:w-44 flex-shrink-0' : width === 'auto' ? '' : 'w-full'}`}
>
  <div class="aspect-square w-full mb-4 relative shadow-[0_8px_24px_rgba(0,0,0,0.5)] rounded-md overflow-hidden">
    <img src={cover} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
    <PlayButton 
      bookId={id.toString()}
      chapIndex={0}
      class="absolute right-3 bottom-3 w-12 h-12 rounded-full bg-[#1db954] flex items-center justify-center text-black shadow-[0_8px_8px_rgba(0,0,0,0.3)] opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 hover:scale-105 hover:bg-[#1ed760] play-btn-overlay"
      svgClass="w-6 h-6 ml-1"
    />
    {showLike && (
      /* Heart on Album Card is disabled as it represents the first track, not the album */
      null
    )}
  </div>
  <div class="font-bold text-base truncate text-white mb-1 group-hover:underline">{title}</div>
  <div class="text-sm text-white/70 truncate line-clamp-2 leading-tight">By {artist}</div>
</a>
