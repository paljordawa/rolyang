---
// import PlayButton from './PlayButton.astro';
// import LikeButton from './LikeButton.astro';

export interface Props {
  id: string | number;
  title: string;
  artist: string;
  cover: string;
  width?: "full" | "auto" | "fixed";
  showLike?: boolean;
}
const { id, title, artist, cover } = Astro.props;
---
<a 
  href={`/album/${id}`}
  class="flex flex-col bg-surface-panel/40 backdrop-blur-xl hover:bg-white/10 border border-white/5 transition-all duration-500 rounded-lg group cursor-pointer relative w-full h-full shadow-lg overflow-hidden"
>
  <div class="aspect-square w-full mb-2 relative shadow-[0_12px_30px_rgba(0,0,0,0.6)] overflow-hidden ring-1 ring-white/10">
    <img src={cover} alt={title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
       <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-primary to-brand-secondary flex items-center justify-center text-white shadow-[0_0_20px_rgba(99,102,241,0.6)] scale-90 group-hover:scale-100 transition-all duration-500 hover:scale-110">
         <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 ml-0.5"><path d="M5.25 5.036a.75.75 0 011.125-.66l12 7a.75.75 0 010 1.287l-12 7A.75.75 0 015.25 19.964V5.036z" /></svg>
       </div>
    </div>
  </div>
  <div class="flex flex-col flex-1 min-w-0 px-2 pb-2">
    <div class="font-medium text-[12px] truncate text-white mb-0.5 leading-snug font-heading tracking-wide group-hover:text-brand-accent transition-colors">{title}</div>
    <div class="text-[10px] text-white/40 truncate mb-2">Album • {artist}</div>
    
    <div class="flex items-center justify-between mt-auto js-card-meta">
       <div class="flex items-center gap-1.5">
          <div class="w-1 h-1 rounded-full bg-brand-primary shadow-[0_0_6px_rgba(99,102,241,0.8)]"></div>
          <span class="text-[8px] text-brand-primary font-bold uppercase tracking-[0.15em]">Luminous</span>
       </div>
       <button class="md:hidden w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white active:bg-brand-primary active:text-white transition-all shadow-xl">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3 ml-0.5"><path d="M8 5v14l11-7z"/></svg>
       </button>
    </div>
  </div>
</a>

