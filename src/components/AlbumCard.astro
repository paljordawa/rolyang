---
// import PlayButton from './PlayButton.astro';
// import LikeButton from './LikeButton.astro';

export interface Props {
  id: string | number;
  title: string;
  artist: string;
  cover: string;
  width?: "full" | "auto" | "fixed";
  showLike?: boolean;
}
const { id, title, artist, cover } = Astro.props;
---
<a 
  href={`/album/${id}`}
  class="flex flex-col p-3 bg-[#181818] hover:bg-[#282828] transition-all duration-300 rounded-xl group cursor-pointer relative w-full h-full"
>
  <div class="aspect-square w-full mb-3 relative shadow-[0_12px_40px_rgba(0,0,0,0.7)] rounded-lg overflow-hidden ring-1 ring-white/5">
    <img src={cover} alt={title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
       <div class="w-14 h-14 rounded-full bg-[#1db954] flex items-center justify-center text-black shadow-2xl scale-90 group-hover:scale-100 transition-all duration-300 hover:scale-110">
         <svg viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7 ml-1"><path d="M5.25 5.036a.75.75 0 011.125-.66l12 7a.75.75 0 010 1.287l-12 7A.75.75 0 015.25 19.964V5.036z" /></svg>
       </div>
    </div>
  </div>
  <div class="flex flex-col flex-1 min-w-0 px-1 pb-1">
    <div class="font-bold text-[15px] md:text-base truncate text-white mb-0.5 group-hover:underline leading-snug">{title}</div>
    <div class="text-[12px] text-white/50 truncate mb-2">Album • {artist}</div>
    
    <div class="flex items-center justify-between mt-auto js-card-meta">
       <div class="flex items-center gap-1.5">
          <div class="w-1.5 h-1.5 rounded-full bg-[#1db954]"></div>
          <span class="text-[9px] text-[#1db954] font-bold uppercase tracking-[0.1em]">Ready</span>
       </div>
       <button class="md:hidden w-9 h-9 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white active:bg-[#1db954] active:text-black transition-all">
          <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 ml-0.5"><path d="M8 5v14l11-7z"/></svg>
       </button>
    </div>
  </div>
</a>

