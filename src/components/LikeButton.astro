---
export interface Props {
  albumId: string;
  chapId: string;
  class?: string;
  svgClass?: string;
  strokeClass?: string;
}

const { 
  albumId, 
  chapId, 
  class: className = '', 
  svgClass = 'w-4 h-4',
  strokeClass = 'stroke-white/50 hover:stroke-white' 
} = Astro.props;
---
<button 
  type="button"
  class={`js-like-btn ${className}`}
  data-album-id={albumId} 
  data-chap-id={chapId}
  aria-label="Like"
>
  <svg class={`${svgClass} empty-heart ${strokeClass} fill-none stroke-2`} viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
  </svg>
  <svg class={`${svgClass} filled-heart text-brand-primary drop-shadow-[0_0_8px_rgba(99,102,241,0.6)] hidden`} viewBox="0 0 24 24" fill="currentColor">
    <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"></path>
  </svg>
</button>
