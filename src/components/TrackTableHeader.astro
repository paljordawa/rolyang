---
export interface Props {
  className?: string;
}
const { className = "mb-4" } = Astro.props;
---
<div class={`grid grid-cols-[3fr_1.5fr_1.5fr_1.5fr_1fr_minmax(130px,auto)] gap-4 px-4 py-2 border-b border-white/10 text-white/60 text-sm font-medium uppercase tracking-[0.1em] text-left items-center ${className}`}>
  <div>Title</div>
  <div class="hidden sm:block">Artist</div>
  <div class="hidden md:block">Album</div>
  <div class="hidden lg:block">Genre</div>
  <div class="hidden md:block text-right pr-4">Plays</div>

  <div class="flex justify-end pr-8"></div>
</div>
