---
export interface Props {
  bookId: string;
  chapIndex: number;
  trackId?: string; // Optional track identity for cross-view highlighting
  class?: string;
  svgClass?: string;
}

const { 
  bookId, 
  chapIndex, 
  trackId,
  class: className = '', 
  svgClass = 'w-5 h-5 ml-1' 
} = Astro.props;
---
<button 
  type="button"
  class={`${className}`}
  aria-label="Play"
  data-player-album={bookId}
  data-player-chap={chapIndex}
  data-track-id={trackId}
>
  <svg viewBox="0 0 24 24" fill="currentColor" class={`${svgClass}`}><path d="M5.25 5.036a.75.75 0 0 1 1.125-.66l12 7a.75.75 0 0 1 0 1.287l-12 7A.75.75 0 0 1 5.25 19.964V5.036z" /></svg>
</button>
