---
import PlayButton from "./PlayButton.astro";
import LikeButton from "./LikeButton.astro";

export interface Props {
  album: any;
  track: any;
  index: number;
}
const { album, track, index } = Astro.props;
const trackIndex = index;
const genre = album.genre || "Electronic";
---

<div
  class="flex items-center sm:grid sm:grid-cols-[3fr_1.5fr_1.5fr_1.5fr_1fr_minmax(130px,auto)] gap-4 px-0 sm:px-4 py-3 sm:py-2 rounded transition-colors hover:bg-white/10 group cursor-default bg-transparent w-full border-b border-white/5 sm:border-none"
  data-player-row
  data-track-id={track.id}
  data-track-title={track.title}
  data-artist-name={album.artist}
  data-player-album={album.id}
  data-player-chap={trackIndex}
>
  <!-- Title / Mobile Main Cell -->
  <div class="flex items-center gap-3 min-w-0 flex-1 sm:flex-initial">
    <div
      class="w-12 h-12 sm:w-10 sm:h-10 rounded shrink-0 overflow-hidden bg-white/5 relative group/thumb"
    >
      <img src={album.cover} alt="" class="w-full h-full object-cover group-hover:brightness-50 transition-all" />
      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
        <PlayButton
          bookId={album.id.toString()}
          chapIndex={trackIndex}
          trackId={track.id.toString()}
          class="text-brand-primary active:scale-90 transition-transform"
          svgClass="w-5 h-5 fill-current drop-shadow-[0_0_8px_rgba(99,102,241,0.5)]"
        />
        <!-- Hidden/Overlay label for playback indicator state -->
        <span data-index-label data-original-index={trackIndex + 1} class="hidden"></span>
      </div>
    </div>
    <div class="flex flex-col min-w-0">
      <a
        href={`/song/track-${track.id}`}
        class="text-sm sm:text-base font-medium text-white truncate hover:underline cursor-pointer block max-w-fit"
        data-player-title
        data-player-album={album.id}
        data-player-chap={trackIndex}
      >
        {track.title || album.artist}
      </a>
      <!-- Mobile sub-info: Artist + Plays -->
      <div
        class="flex items-center text-[11px] text-white/50 sm:hidden mt-0.5 font-normal"
      >
        {
          track.play_count ? (
            <span>
              {track.play_count >= 1000000
                ? (track.play_count / 1000000).toFixed(0) + "M"
                : track.play_count >= 1000
                  ? (track.play_count / 1000).toFixed(0) + "K"
                  : track.play_count}{" "}
              Plays
            </span>
          ) : (
            <span class="truncate">{album.artist}</span>
          )
        }
      </div>
    </div>
  </div>

  <!-- Artist Cell (Desktop) -->
  <div class="hidden sm:flex items-center min-w-0">
    <a
      href={`/artist/${encodeURIComponent(album.artist)}`}
      class="text-sm text-white/70 truncate hover:text-white cursor-pointer hover:underline"
      >{album.artist}</a
    >
  </div>

  <!-- Album Cell (Desktop) -->
  <div class="hidden md:flex items-center min-w-0">
    <a
      href={`/album/${album.id}`}
      class="text-sm text-white/70 truncate hover:text-white cursor-pointer hover:underline block"
      >{album.title}</a
    >
  </div>

  <!-- Genre Cell (Desktop) -->
  <div class="hidden lg:flex items-center min-w-0">
    <span
      class="text-sm text-white/70 truncate capitalize cursor-pointer hover:text-white hover:underline"
      >{genre}</span
    >
  </div>

  <!-- Plays Cell (Desktop) -->
  <div
    class="hidden md:flex items-center justify-end min-w-0 text-sm text-white/70 pr-4 tabular-nums"
  >
    {(track.play_count || 0).toLocaleString()}
  </div>



  <!-- Actions (Mobile & Desktop) -->
  <div class="flex items-center justify-end shrink-0 gap-3 sm:gap-4 sm:pr-4">
    <!-- Desktop ADD (+) -->
    <button
      type="button"
      class="hidden sm:block js-add-to-playlist-btn opacity-0 group-hover:opacity-100 transition-opacity focus:opacity-100 text-white/50 hover:text-white p-1"
      data-track-id={track.id}
      title="Add to Playlist"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg
      >
    </button>

    <!-- Like / Check (Always visible on mobile, hover on desktop) -->
    <div class="opacity-100">
      <LikeButton albumId={album.id.toString()} chapId={track.id.toString()} />
    </div>


    <!-- More Options (...) -->
    <button
      type="button"
      class="js-track-more-btn p-1 hover:text-white text-white/70 opacity-100 transition-all flex items-center justify-center"
      data-track-id={track.id}
      data-artist-name={album.artist}
      data-track-title={track.title}
      title="More"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"
        ><circle cx="5" cy="12" r="1.5"></circle><circle cx="12" cy="12" r="1.5"
        ></circle><circle cx="19" cy="12" r="1.5"></circle></svg
      >
    </button>
  </div>
</div>
