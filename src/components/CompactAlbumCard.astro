---
// import PlayButton from './PlayButton.astro';

export interface Props {
  id: string | number;
  title: string;
  artist?: string;
  cover: string;
  class?: string;
}
const { id, title, artist, cover, class: className = "" } = Astro.props;
---
<a 
  href={`/album/${id}`}
  class={`flex items-center gap-4 bg-surface-panel/30 hover:bg-white/10 border border-white/5 backdrop-blur-md transition-all p-2 rounded-lg group cursor-pointer relative shadow-sm hover:shadow-xl hover:-translate-y-0.5 ${className}`}
>
  <div class="w-14 h-14 md:w-16 md:h-16 shrink-0 relative rounded overflow-hidden shadow-lg border border-white/5">
     <img src={cover} alt={title} class="w-full h-full object-cover" />
     <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-primary to-brand-secondary flex items-center justify-center text-white shadow-lg scale-75 group-hover:scale-100 transition-all duration-300">
           <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 ml-1"><path d="M8 5v14l11-7z"/></svg>
        </div>
     </div>
  </div>
  <div class="flex-1 min-w-0 pr-1">
    <div class="font-medium text-[14px] md:text-base text-white truncate leading-tight group-hover:underline">{title}</div>
    {artist && <div class="text-[11px] md:text-sm text-white/50 truncate mt-0.5">{artist}</div>}
  </div>
  
  {/* Absolute play overlay for better UX */}
  <div class="absolute right-4 opacity-0 group-hover:opacity-100 transition-opacity hidden md:block">
     <div class="text-brand-primary drop-shadow-[0_0_8px_rgba(99,102,241,0.6)]">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
     </div>
  </div>
</a>
