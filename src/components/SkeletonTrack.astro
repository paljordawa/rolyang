---
interface Props {
  count?: number;
}
const { count = 5 } = Astro.props;
---
<ul class="space-y-3 px-3">
  {Array.from({ length: count }).map((_, i) => (
    <li class="flex items-center justify-between rounded-lg bg-white/5 p-3">
      <div class="flex items-center gap-3 w-full">
        <div class="flex-1">
          <div class="h-4 bg-white/10 rounded w-1/3 shimmer"></div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-9 h-9 rounded-full bg-white/5 shimmer"></div>
        <div class="w-9 h-9 rounded-full bg-white/5 shimmer"></div>
      </div>
    </li>
  ))}
</ul>
