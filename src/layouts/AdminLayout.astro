---
import { ClientRouter } from 'astro:transitions';
import "../styles.css"

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Rolyang Admin" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <ClientRouter />
	</head>
	<body class="bg-black text-white selection:bg-white selection:text-black">
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--primary: #fff;
		--surface: #0a0a0a;
		--border: #1a1a1a;
	}
	html, body {
		height: 100%;
		margin: 0;
    overflow: hidden;
	}
</style>
