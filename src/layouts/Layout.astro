    <script>
      import { $likedTracks, toggleLike } from '../store/playerStore';

      // 1. Global Click Delegation for Heart Icons
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.js-like-btn') as HTMLElement;
        if (btn) {
          const albumId = btn.getAttribute('data-album-id');
          const chapId = btn.getAttribute('data-chap-id');
          if (albumId && chapId) {
            // @ts-ignore
            // @ts-ignore
            if (window.__nanostores_player && typeof (window as any).__nanostores_player.toggleLike === 'function') {
              // @ts-ignore
              window.__nanostores_player.toggleLike(albumId, chapId);
            } else {
              toggleLike(albumId, chapId);
            }
          }
        }
      });

      // 2. Global Sync: Update ALL heart icons when state changes
      $likedTracks.subscribe((likes: Record<string, boolean>) => {
        document.querySelectorAll('.js-like-btn').forEach((btn: Element) => {
          const albumId = btn.getAttribute('data-album-id');
          const chapId = btn.getAttribute('data-chap-id');
          const isLiked = !!likes[`${albumId}:${chapId}`];
          
          const empty = btn.querySelector('.empty-heart');
          const filled = btn.querySelector('.filled-heart');
          
          if (isLiked) {
            empty?.classList.add('hidden');
            filled?.classList.remove('hidden');
          } else {
            empty?.classList.remove('hidden');
            filled?.classList.add('hidden');
          }
        });
      });

      // 3. Global Follow Logic
      import { $followedArtists, toggleFollow } from '../store/playerStore';

      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.js-follow-btn') as HTMLElement;
        if (btn) {
          const name = btn.getAttribute('data-artist-name');
          if (name) {
            // @ts-ignore
            if (window.__nanostores_player) {
              // @ts-ignore
              window.__nanostores_player.toggleFollow(name);
            } else {
              toggleFollow(name);
            }
          }
        }
      });

      $followedArtists.subscribe((followed: Record<string, boolean>) => {
        document.querySelectorAll('.js-follow-btn').forEach((btn: Element) => {
          const name = btn.getAttribute('data-artist-name');
          const isFollowed = !!followed[name || ""];
          
          (btn as HTMLElement).textContent = isFollowed ? 'Following' : 'Follow';
          if (isFollowed) {
             btn.classList.add('bg-[#1db954]', 'border-[#1db954]', 'text-black');
             btn.classList.remove('border-white/30', 'text-white');
          } else {
             btn.classList.remove('bg-[#1db954]', 'border-[#1db954]', 'text-black');
             btn.classList.add('border-white/30', 'text-white');
          }
        });
      });

      // --- Add to Playlist Global Logic ---
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest('.js-add-to-playlist-btn') as HTMLElement;
        if (!btn) return;
        
        const trackId = btn.getAttribute('data-track-id');
        if (trackId) showPlaylistSelector(trackId, btn);
      });

      function showPlaylistSelector(trackId: string, anchor: HTMLElement) {
        let selector = document.getElementById('global-playlist-selector');
        if (!selector) {
          selector = document.createElement('div');
          selector.id = 'global-playlist-selector';
          selector.className = 'fixed z-[100] bg-[#282828] border border-white/10 rounded shadow-2xl py-2 w-48 hidden';
          document.body.appendChild(selector);
        }

        const playlists = (window as any).__userPlaylists || [];
        selector.innerHTML = `
          <div class="px-4 py-2 text-[11px] font-bold text-white/50 uppercase tracking-wider">Add to playlist</div>
          ${playlists.map((p: any) => `
            <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white truncate" data-playlist-id="${p.id}">${p.title}</div>
          `).join('')}
        `;

        // Position it near the button
        const rect = anchor.getBoundingClientRect();
        selector.style.top = `${rect.bottom + window.scrollY + 5}px`;
        selector.style.left = `${rect.left + window.scrollX - 160}px`;
        selector.classList.remove('hidden');

        // Handle item click
        const items = selector.querySelectorAll('[data-playlist-id]');
        items.forEach(item => {
          item.addEventListener('click', async () => {
            const playlistId = item.getAttribute('data-playlist-id');
            try {
              const res = await fetch('/api/library/playlists/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ playlistId, trackId })
              });
              if (res.ok) {
                 // Simple feedback
                 const originalContent = anchor.innerHTML;
                 anchor.innerHTML = '<svg class="w-4 h-4 text-[#1db954]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>';
                 setTimeout(() => { anchor.innerHTML = originalContent; }, 2000);
              }
            } catch (e) {
              console.error('Failed to add track to playlist:', e);
            }
            selector?.classList.add('hidden');
          });
        });

        // Close on outside click
        const closeOnOutside = (e: MouseEvent) => {
          if (selector && !selector.contains(e.target as Node) && e.target !== anchor) {
            selector.classList.add('hidden');
            document.removeEventListener('click', closeOnOutside);
          }
        };
        setTimeout(() => document.addEventListener('click', closeOnOutside), 10);
      }

      // --- Track Context Menu ---
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.js-track-more-btn') as HTMLElement;
        if (!btn) return;
        
        const trackId = btn.getAttribute('data-track-id');
        if (!trackId) return;

        showTrackContextMenu(trackId, btn);
      });

      function showTrackContextMenu(trackId: string, anchor: HTMLElement) {
        let menu = document.getElementById('global-track-context-menu');
        if (!menu) {
          menu = document.createElement('div');
          menu.id = 'global-track-context-menu';
          menu.className = 'fixed z-[100] bg-[#282828] border border-white/10 rounded shadow-2xl py-1 w-48 hidden';
          document.body.appendChild(menu);
        }

        let extraItems = '';
        const isPlaylistPage = window.location.pathname.startsWith('/playlist/');
        if (isPlaylistPage) {
           const playlistId = window.location.pathname.split('/').pop();
           extraItems = `
            <div class="h-[1px] bg-white/10 my-1"></div>
            <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white flex items-center gap-3" id="ctx-remove-from-playlist" data-playlist-id="${playlistId}">
               <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
               Remove from this playlist
            </div>
           `;
        }

        menu.innerHTML = `
          <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white flex items-center gap-3" id="ctx-add-to-playlist">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Add to playlist
          </div>
          <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white flex items-center gap-3" id="ctx-create-playlist">
             <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
             Create Playlist
          </div>
          ${extraItems}
          <div class="h-[1px] bg-white/10 my-1"></div>
          <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white flex items-center gap-3" id="ctx-go-to-artist">
             <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
             Go to artist
          </div>
        `;

        // Position
        const rect = anchor.getBoundingClientRect();
        menu.style.top = `${rect.bottom + window.scrollY + 5}px`;
        menu.style.left = `${rect.left + window.scrollX - 160}px`;
        menu.classList.remove('hidden');

        // Actions
        menu.querySelector('#ctx-add-to-playlist')?.addEventListener('click', () => {
          menu?.classList.add('hidden');
          showPlaylistSelector(trackId, anchor);
        });

        menu.querySelector('#ctx-create-playlist')?.addEventListener('click', () => {
          menu?.classList.add('hidden');
          (window as any).createPlaylist();
        });

        menu.querySelector('#ctx-remove-from-playlist')?.addEventListener('click', async () => {
          const playlistId = (menu?.querySelector('#ctx-remove-from-playlist') as HTMLElement).getAttribute('data-playlist-id');
          menu?.classList.add('hidden');
          if (!playlistId) return;

          try {
             const res = await fetch('/api/library/playlists/remove', {
               method: 'POST',
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify({ playlistId, trackId })
             });
             if (res.ok) {
                location.reload();
             }
          } catch (e) {
             console.error('Failed to remove track:', e);
          }
        });

        menu.querySelector('#ctx-go-to-artist')?.addEventListener('click', () => {
          menu?.classList.add('hidden');
          // We don't have the artist name here easily without passing it, 
          // but we can find it from the row if needed.
          const row = anchor.closest('[data-player-row]') as HTMLElement;
          const artistLink = row?.querySelector('a[href^="/artist/"]') as HTMLAnchorElement;
          if (artistLink) {
             // @ts-ignore
             window.appNavigate(artistLink.getAttribute('href'));
          }
        });

        // Close on outside click
        const closeMenu = (e: MouseEvent) => {
          if (menu && !menu.contains(e.target as Node) && e.target !== anchor) {
            menu.classList.add('hidden');
            document.removeEventListener('click', closeMenu);
          }
        };
        setTimeout(() => document.addEventListener('click', closeMenu), 10);
      }
    </script>

    <!-- Create Playlist Modal -->
