---
import { ClientRouter } from 'astro:transitions';
import Player from '../components/Player.jsx';
import { createSupabaseServerClient } from '../lib/supabaseServer';
import "../styles.css"

const { backHref, playerStart, hidePlayerUntilPlaying } = Astro.props;
const supabase = createSupabaseServerClient(Astro);

// 1. Parallelize core data fetching
const [ { data: authData }, { data: albumsResult } ] = await Promise.all([
  supabase.auth.getUser(),
  supabase.from('albums')
    .select('id, title, artist, cover, tracks(id, title, audio, album_id)')
    .order('id', { ascending: true })
]);

const albumsBase = albumsResult || [];
const user = authData?.user;
let playlists = [];

// 2. Conditional fetching for user-specific data
if (user) {
  const { data: userPlaylists } = await supabase
    .from('playlists')
    .select('id, title, cover, playlist_tracks(track_id, tracks(id, title, audio, albums(id, title, artist, cover)))')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false });
  playlists = userPlaylists || [];
}

const albums = albumsBase.map((album) => ({
  ...album,
  chapters: (album.tracks || []).map((t: any) => ({
    ...t,
    album_id: t.album_id?.toString()
  }))
}));

// Build playable "books" from playlists
const playlistsWithTracks = playlists.map((p: any) => {
  const tracks = (p.playlist_tracks || []).map((pt: any) => ({
    ...pt.tracks,
    album_title: pt.tracks.albums?.title,
    album_artist: pt.tracks.albums?.artist,
    album_cover: pt.tracks.albums?.cover
  }));

  return {
    ...p,
    id: `playlist-${p.id}`,
    artist: 'User Playlist',
    cover: p.cover !== 'gradient' ? p.cover : (tracks[0]?.album_cover || '/social.jpg'),
    chapters: tracks
  };
});

const allBooksForPlayer = [...albums, ...playlistsWithTracks];
const cleanPlaylists = playlists;

const siteTitle = 'Rolyang Music Player';
const siteDescription = 'Listen to curated music from the Rolyang collection.';

// Sanitize playerStart props for React/Astro serialization
const cleanPlayerStart = playerStart ? {
  ...playerStart,
  startBookId: playerStart.startBookId?.toString()
} : null;
const siteOrigin = Astro.site ? Astro.site.origin : '';
const canonicalUrl = siteOrigin ? new URL(Astro.url.pathname + Astro.url.search + Astro.url.hash, siteOrigin).toString() : Astro.url?.href || '';
const ogImagePath = '/social.jpg';
const ogImageUrl = siteOrigin ? new URL(ogImagePath, siteOrigin).toString() : ogImagePath;
---

<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Cover artwork for Rolyang Audiobooks." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
    <script>
      import { initApp } from "../scripts/main";
      document.addEventListener('astro:page-load', () => initApp());
    </script>
  </head>
  <body class="bg-surface-base text-white h-[100dvh] overflow-hidden flex flex-col font-sans select-none">
    <div class="flex-1 flex overflow-hidden md:p-3 md:gap-3 h-full md:h-[calc(100svh-95px)] relative">
      <!-- Left Sidebar (Desktop only) -->
      <aside class="hidden md:flex flex-col w-64 lg:w-80 bg-surface-panel/40 backdrop-blur-xl border border-white/5 rounded-xl overflow-hidden flex-shrink-0">
        <!-- Home / Search Nav -->
        <nav class="p-5 space-y-4">
          <a href="/" class="flex items-center gap-5 text-white/70 hover:text-white transition-colors duration-200">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12.5 3.247a1 1 0 00-1 0L4 7.577V20h4.5v-6a1 1 0 011-1h5a1 1 0 011-1v6H20V7.577l-7.5-4.33z"/></svg>
            <span class="font-bold text-sm">Home</span>
          </a>
          <a href="/search" class="flex items-center gap-5 text-white/70 hover:text-white transition-colors duration-200">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <span class="font-bold text-sm">Search</span>
          </a>
        </nav>

        <!-- Library Section -->
        <div class="flex-1 mt-2 bg-white/5 rounded-xl p-3 flex flex-col overflow-hidden">
          <div class="flex items-center justify-between text-white/70 hover:text-white transition-colors duration-200 mb-4 px-2 cursor-pointer group">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 016.5 2H20v20H6.5a2.5 2.5 0 010-5H20"/></svg>
              <span class="font-bold text-sm">Your Library</span>
            </div>
            <div class="flex gap-2">
              <span id="create-playlist-btn" class="p-1 hover:bg-white/10 rounded-full transition cursor-pointer" title="Create Playlist"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span>
              <span class="p-1 hover:bg-white/10 rounded-full transition"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
            </div>
          </div>
          
          <div class="flex gap-2 px-2 pb-4 overflow-x-auto no-scrollbar">
             <span data-library-filter="playlists" class="px-3 py-1.5 rounded-full text-black bg-white text-xs font-semibold hover:bg-white/20 transition cursor-pointer whitespace-nowrap js-library-pill active-pill">Playlists</span>
             <span data-library-filter="albums" class="px-3 py-1.5 rounded-full bg-white/10 text-xs font-semibold hover:bg-white/20 transition cursor-pointer whitespace-nowrap js-library-pill">Albums</span>
             <span data-library-filter="artists" class="px-3 py-1.5 rounded-full bg-white/10 text-xs font-semibold hover:bg-white/20 transition cursor-pointer whitespace-nowrap js-library-pill">Artists</span>
          </div>
          
          <!-- Library container -->
          <div id="library-list-container" class="overflow-y-auto flex-1 px-1 space-y-1">
            <div class="p-4 text-center text-white/40 text-sm">Loading library...</div>
          </div>
          <!-- Library data injection -->
          <script is:inline set:html={`window.__libraryData = ${JSON.stringify(albums)}; window.__userPlaylists = ${JSON.stringify(cleanPlaylists)};`} />
        </div>
      </aside>

      <!-- Main Content Area -->
      <main id="main-content" class="flex-1 bg-surface-base border border-white/5 rounded-xl overflow-y-auto overflow-x-hidden relative shadow-2xl">
         <!-- Top sticky header -->
         <header id="main-header" class="sticky top-0 z-40 bg-transparent flex items-center justify-between px-4 md:px-6 py-5 transition-all duration-300">
            <div class="flex items-center gap-4 flex-1 h-8" id="header-dynamic-zone"></div>
            
             <div class="flex items-center gap-3 md:gap-4 relative">
               {user ? (
                  <div class="flex items-center gap-3">
                    <div class="relative" id="profile-menu-container">
                      <div id="profile-btn" class="w-8 h-8 rounded-full bg-pink-500 hover:scale-105 transition flex items-center justify-center font-bold text-black text-sm cursor-pointer shadow-[0_2px_4px_rgba(0,0,0,0.3)] overflow-hidden border-2 border-transparent hover:border-white/50">
                        {user.user_metadata?.avatar_url ? <img src={user.user_metadata.avatar_url} alt="Profile" class="w-full h-full object-cover" /> : (user.email?.charAt(0).toUpperCase() || 'U')}
                      </div>
                      <div class="absolute -top-1 -right-1.5 w-3.5 h-3.5 bg-yellow-400 rounded-full border-[1.5px] border-[#121212] flex items-center justify-center shadow-md z-10 pointer-events-none" title="Premium Member">
                        <svg width="6" height="6" viewBox="0 0 24 24" fill="currentColor" class="text-black"><path d="M12 2l2.4 7.4h7.6l-6.2 4.4 2.4 7.4-6.2-4.6-6.2 4.6 2.4-7.4-6.2-4.4h7.6z"/></svg>
                      </div>
                      <div id="profile-dropdown" class="absolute right-0 mt-2 w-48 bg-[#282828] rounded-md shadow-2xl py-1 opacity-0 pointer-events-none transform scale-95 transition-all duration-200 origin-top-right z-50 border border-white/10">
                        <div class="px-4 py-3 border-b border-white/10">
                          <p class="text-sm font-medium text-white truncate">{user.user_metadata?.full_name || 'User'}</p>
                          <p class="text-xs text-white/50 truncate">{user.email}</p>
                        </div>
                        <div class="py-1">
                          <a href="/library" class="block px-4 py-2 text-sm text-white/80 hover:bg-white/10">Your Library</a>
                          <button id="logout-btn" class="block px-4 py-2 text-sm text-white/80 hover:bg-white/10 w-full text-left">Log out</button>
                        </div>
                      </div>
                    </div>
                  </div>
               ) : (
                 <a href="/login" class="rounded-full bg-white text-black font-bold text-[14px] px-6 py-2 hover:scale-105 transition">Log in</a>
               )}
            </div>
         </header>
         
         <div class="pb-24 pt-1 min-h-full px-2.5 md:px-6"> 
           <slot />
         </div>
      </main>
    </div>

    <!-- Bottom Player Island -->
    <div class="fixed md:absolute left-2 right-2 md:left-4 md:right-4 bottom-[74px] md:bottom-4 z-50 md:h-[100px] transition-all duration-500 player-wrapper bg-surface-panel/80 backdrop-blur-2xl rounded-2xl shadow-2xl border border-white/10 overflow-hidden" data-player-shell data-hidden={hidePlayerUntilPlaying ? 'true' : 'false'} transition:persist="player-shell">
      <Player client:load books={(allBooksForPlayer as any)} startBookId={cleanPlayerStart?.startBookId} startChapIndex={cleanPlayerStart?.startChapIndex} />
    </div>

    <!-- Mobile Bottom Navigation -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-[60] flex items-center justify-around bg-black py-2 border-t border-white/10" data-bottom-nav>
        <a href="/" class="flex flex-col items-center gap-1 text-white"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12.5 3.247a1 1 0 00-1 0L4 7.577V20h4.5v-6a1 1 0 011-1h5a1 1 0 011 1v6H20V7.577l-7.5-4.33z"/></svg><span class="text-[10px]">Home</span></a>
        <a href="/search" class="flex flex-col items-center gap-1 text-white/50 hover:text-white transition"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg><span class="text-[10px]">Search</span></a>
        <a href="/library" class="flex flex-col items-center gap-1 text-white/50 hover:text-white transition"><svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5v-15A2.5 2.5 0 016.5 2H20v20H6.5a2.5 2.5 0 010-5H20"/></svg><span class="text-[10px]">Library</span></a>
    </nav>

    <!-- Create Playlist Modal -->
    <div id="create-playlist-modal" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/80 backdrop-blur-sm hidden">
      <div class="bg-[#282828] w-full max-w-md rounded-xl shadow-2xl p-8 border border-white/5">
        <h2 id="modal-title" class="text-2xl font-black text-white mb-6">Create Playlist</h2>
        <div class="space-y-4">
          <input type="text" id="playlist-name-input" placeholder="Playlist Name" class="w-full bg-[#3e3e3e] border-none rounded-md p-3 text-white outline-none"/>
          <textarea id="playlist-description-input" rows="3" placeholder="Description" class="w-full bg-[#3e3e3e] border-none rounded-md p-3 text-white outline-none resize-none"></textarea>
        </div>
        <div class="flex items-center justify-end gap-4 mt-8">
          <button id="cancel-playlist-btn" class="px-6 py-2.5 text-sm font-bold text-white">Cancel</button>
          <button id="confirm-playlist-btn" class="px-8 py-2.5 bg-[#1db954] rounded-full text-black text-sm font-bold">Create</button>
        </div>
      </div>
    </div>

    <style is:global>
      [data-player-row][data-active="true"] [data-player-title] { color: #1db954 !important; }
      [data-player-shell][data-hidden="true"] { opacity: 0; pointer-events: none; transform: translateY(24px); }
    </style>
  </body>
</html>