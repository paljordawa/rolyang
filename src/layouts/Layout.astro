      [data-player-shell][data-hidden="true"]{opacity:0;pointer-events:none;transform:translateY(24px);}
    </style>
        <script>
(() => {
function reveal() {
  const shell = document.querySelector('[data-player-shell]') as HTMLElement;
  if (!shell) return;
  if (shell.dataset.hidden !== 'false') shell.dataset.hidden = 'false';
}
window.addEventListener('player:now-playing', (ev) => {
  if (ev && (ev as CustomEvent).detail && (ev as CustomEvent).detail.isPlaying !== false) reveal();
});
window.addEventListener('player:play', () => reveal());
try {
  if ((window as any).__playerNowPlaying && (window as any).__playerNowPlaying.isPlaying !== false) reveal();
} catch (e) {}
})();
        </script>
      </>
    ) : null}
    <script>
      import { $likedTracks, toggleLike } from '../store/playerStore';

      // 1. Global Click Delegation for Heart Icons
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.js-like-btn') as HTMLElement;
        if (btn) {
          const albumId = btn.getAttribute('data-album-id');
          const chapId = btn.getAttribute('data-chap-id');
          if (albumId && chapId) {
            // @ts-ignore
            // @ts-ignore
            if (window.__nanostores_player && typeof (window as any).__nanostores_player.toggleLike === 'function') {
              // @ts-ignore
              window.__nanostores_player.toggleLike(albumId, chapId);
            } else {
              toggleLike(albumId, chapId);
            }
          }
        }
      });

      // 2. Global Sync: Update ALL heart icons when state changes
      $likedTracks.subscribe((likes: Record<string, boolean>) => {
        document.querySelectorAll('.js-like-btn').forEach((btn: Element) => {
          const albumId = btn.getAttribute('data-album-id');
          const chapId = btn.getAttribute('data-chap-id');
          const isLiked = !!likes[`${albumId}:${chapId}`];
          
          const empty = btn.querySelector('.empty-heart');
          const filled = btn.querySelector('.filled-heart');
          
          if (isLiked) {
            empty?.classList.add('hidden');
            filled?.classList.remove('hidden');
          } else {
            empty?.classList.remove('hidden');
            filled?.classList.add('hidden');
          }
        });
      });

      // 3. Global Follow Logic
      import { $followedArtists, toggleFollow } from '../store/playerStore';

      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.js-follow-btn') as HTMLElement;
        if (btn) {
          const name = btn.getAttribute('data-artist-name');
          if (name) {
            // @ts-ignore
            if (window.__nanostores_player) {
              // @ts-ignore
              window.__nanostores_player.toggleFollow(name);
            } else {
              toggleFollow(name);
            }
          }
        }
      });

      $followedArtists.subscribe((followed: Record<string, boolean>) => {
        document.querySelectorAll('.js-follow-btn').forEach((btn: Element) => {
          const name = btn.getAttribute('data-artist-name');
          const isFollowed = !!followed[name || ""];
          
          (btn as HTMLElement).textContent = isFollowed ? 'Following' : 'Follow';
          if (isFollowed) {
             btn.classList.add('bg-[#1db954]', 'border-[#1db954]', 'text-black');
             btn.classList.remove('border-white/30', 'text-white');
          } else {
             btn.classList.remove('bg-[#1db954]', 'border-[#1db954]', 'text-black');
             btn.classList.add('border-white/30', 'text-white');
          }
        });
      });

      // --- Add to Playlist Global Logic ---
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest('.js-add-to-playlist-btn') as HTMLElement;
        if (!btn) return;
        
        const trackId = btn.getAttribute('data-track-id');
        if (trackId) showPlaylistSelector(trackId, btn);
      });

      function showPlaylistSelector(trackId: string, anchor: HTMLElement) {
        let selector = document.getElementById('global-playlist-selector');
        if (!selector) {
          selector = document.createElement('div');
          selector.id = 'global-playlist-selector';
          selector.className = 'fixed z-[100] bg-[#282828] border border-white/10 rounded shadow-2xl py-2 w-48 hidden';
          document.body.appendChild(selector);
        }

        const playlists = (window as any).__userPlaylists || [];
        selector.innerHTML = `
          <div class="px-4 py-2 text-[11px] font-bold text-white/50 uppercase tracking-wider">Add to playlist</div>
          ${playlists.map((p: any) => `
            <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white truncate" data-playlist-id="${p.id}">${p.title}</div>
          `).join('')}
        `;

        // Position it near the button
        const rect = anchor.getBoundingClientRect();
        selector.style.top = `${rect.bottom + window.scrollY + 5}px`;
        selector.style.left = `${rect.left + window.scrollX - 160}px`;
        selector.classList.remove('hidden');

        // Handle item click
        const items = selector.querySelectorAll('[data-playlist-id]');
        items.forEach(item => {
          item.addEventListener('click', async () => {
            const playlistId = item.getAttribute('data-playlist-id');
            try {
              const res = await fetch('/api/library/playlists/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ playlistId, trackId })
              });
              if (res.ok) {
                 // Simple feedback
                 const originalContent = anchor.innerHTML;
                 anchor.innerHTML = '<svg class="w-4 h-4 text-[#1db954]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>';
                 setTimeout(() => { anchor.innerHTML = originalContent; }, 2000);
              }
            } catch (e) {
              console.error('Failed to add track to playlist:', e);
            }
            selector?.classList.add('hidden');
          });
        });

        // Close on outside click
        const closeOnOutside = (e: MouseEvent) => {
          if (selector && !selector.contains(e.target as Node) && e.target !== anchor) {
            selector.classList.add('hidden');
            document.removeEventListener('click', closeOnOutside);
          }
        };
        setTimeout(() => document.addEventListener('click', closeOnOutside), 10);
      }

      // --- Track Context Menu ---
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.js-track-more-btn') as HTMLElement;
        if (!btn) return;
        
        const trackId = btn.getAttribute('data-track-id');
        if (!trackId) return;

        showTrackContextMenu(trackId, btn);
      });

      function showTrackContextMenu(trackId: string, anchor: HTMLElement) {
        let menu = document.getElementById('global-track-context-menu');
        if (!menu) {
          menu = document.createElement('div');
          menu.id = 'global-track-context-menu';
          menu.className = 'fixed z-[100] bg-[#282828] border border-white/10 rounded shadow-2xl py-1 w-48 hidden';
          document.body.appendChild(menu);
        }

        const trackTitle = anchor.getAttribute('data-track-title') || 'Track';
        const artistName = anchor.getAttribute('data-artist-name');

        let extraItems = '';
        const isPlaylistPage = window.location.pathname.startsWith('/playlist/');
        if (isPlaylistPage) {
           const playlistId = window.location.pathname.split('/').pop();
           extraItems = `
            <div class="h-[1px] bg-white/10 my-1"></div>
            <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white flex items-center gap-3" id="ctx-remove-from-playlist" data-playlist-id="${playlistId}">
               <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
               Remove from this playlist
            </div>
           `;
        }

        menu.innerHTML = `
          <div class="px-4 py-2 text-[10px] font-bold text-white/40 uppercase tracking-widest truncate">${trackTitle}</div>
          <div class="h-[1px] bg-white/5 mb-1"></div>
          <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white flex items-center gap-3" id="ctx-add-to-playlist">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            Add to playlist
          </div>
          <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white flex items-center gap-3" id="ctx-create-playlist">
             <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
             Create Playlist
          </div>
          ${extraItems}
          <div class="h-[1px] bg-white/10 my-1"></div>
          <div class="px-4 py-2 text-sm hover:bg-white/10 cursor-pointer text-white flex items-center gap-3" id="ctx-go-to-artist">
             <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
             Go to artist
          </div>
        `;

        // Position
        const rect = anchor.getBoundingClientRect();
        // Check if there's space below, else show above
        let top = rect.bottom + window.scrollY + 5;
        if (top + 200 > window.innerHeight + window.scrollY) {
           top = rect.top + window.scrollY - 200;
        }
        
        menu.style.top = `${top}px`;
        menu.style.left = `${rect.left + window.scrollX - 160}px`;
        menu.classList.remove('hidden');

        // Actions
        menu.querySelector('#ctx-add-to-playlist')?.addEventListener('click', () => {
          menu?.classList.add('hidden');
          showPlaylistSelector(trackId, anchor);
        });

        menu.querySelector('#ctx-create-playlist')?.addEventListener('click', () => {
          menu?.classList.add('hidden');
          // @ts-ignore
          if (window.createPlaylist) window.createPlaylist(trackId);
        });

        menu.querySelector('#ctx-remove-from-playlist')?.addEventListener('click', async () => {
          const playlistId = (menu?.querySelector('#ctx-remove-from-playlist') as HTMLElement).getAttribute('data-playlist-id');
          menu?.classList.add('hidden');
          if (!playlistId) return;

          try {
             const res = await fetch('/api/library/playlists/remove', {
               method: 'POST',
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify({ playlistId, trackId })
             });
             if (res.ok) {
                const row = anchor.closest('[data-player-row]') as HTMLElement;
                if (row && row.parentElement) {
                  row.remove();
                }
                const countEl = document.querySelector('[data-playlist-track-count]') as HTMLElement;
                if (countEl) {
                  const current = parseInt(countEl.textContent || '0', 10) || 0;
                  const next = Math.max(0, current - 1);
                  countEl.textContent = `${next} track${next === 1 ? '' : 's'}`;
                }
                const playlistList = document.querySelector('.space-y-1');
                if (playlistList && playlistList.querySelectorAll('[data-player-row]').length === 0) {
                  playlistList.innerHTML = `<div class="py-20 text-center text-white/40 italic">This playlist is currently empty. Add tracks from any album!</div>`;
                }
             }
          } catch (e) {
             console.error('Failed to remove track:', e);
          }
        });

        // Close on outside click
        const closeMenu = (e: MouseEvent) => {
          if (menu && !menu.contains(e.target as Node) && e.target !== anchor) {
            menu.classList.add('hidden');
            document.removeEventListener('click', closeMenu);
          }
        };
        setTimeout(() => document.addEventListener('click', closeMenu), 10);
      }
    </script>

    <!-- Create Playlist Modal -->
    <div id="create-playlist-modal" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/80 backdrop-blur-sm hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
      <div class="bg-[#282828] w-full max-w-md rounded-xl shadow-2xl p-8 border border-white/5 animate-in fade-in zoom-in duration-200">
        <h2 id="modal-title" class="text-2xl font-black text-white mb-6 tracking-tight">Create Playlist</h2>
        
        <div class="space-y-4">
          <div>
            <label for="playlist-name-input" class="block text-xs font-bold text-white/50 uppercase tracking-wider mb-2">Playlist Name</label>
            <input 
              type="text" 
              id="playlist-name-input" 
              placeholder="My Awesome Playlist"
              class="w-full bg-[#3e3e3e] border-none rounded-md p-3 text-white placeholder-white/20 focus:ring-2 focus:ring-[#1db954] transition-all outline-none"
            />
          </div>
          
          <div>
            <label for="playlist-description-input" class="block text-xs font-bold text-white/50 uppercase tracking-wider mb-2">Description (optional)</label>
            <textarea 
              id="playlist-description-input" 
              rows="3"
              placeholder="Give your playlist a description"
              class="w-full bg-[#3e3e3e] border-none rounded-md p-3 text-white placeholder-white/20 focus:ring-2 focus:ring-[#1db954] transition-all outline-none resize-none"
            ></textarea>
          </div>
        </div>
        
        <div class="flex items-center justify-end gap-4 mt-8">
          <button id="cancel-playlist-btn" class="px-6 py-2.5 text-sm font-bold text-white hover:scale-105 active:scale-95 transition-all">Cancel</button>
          <button id="confirm-playlist-btn" class="px-8 py-2.5 bg-[#1db954] rounded-full text-black text-sm font-bold shadow-lg hover:scale-105 active:scale-95 transition-all">Create</button>
        </div>
      </div>
    </div>
    <script>
      // Highlight active track in TrackRows continuously synced via Nanostores
      (function() {
        var highlightInterval: any = null;
        
        var updateRows = function() {
          if (!(window as any).__nanostores_player || !(window as any).__nanostores_player.$currentTrack) return;
          
          var track = (window as any).__nanostores_player.$currentTrack.get();
          var playing = (window as any).__nanostores_player.$isPlaying.get();
          if (!track) return;

          console.log('updateRows called, track:', track, 'playing:', playing);

          document.querySelectorAll('[data-player-row]').forEach(function(el) {
            var row = el as HTMLElement;
            var rowTrackId = row.dataset.trackId;
            var rowAlbumId = row.dataset.playerAlbum || row.dataset.playerBook;
            var rowChapIdx = row.dataset.playerChap;
            
            console.log('Checking row:', rowTrackId, rowAlbumId, rowChapIdx);
            
            // Primary check: Match by Track ID (Independent of playlist/album)
            var isCurrent = rowTrackId && track.trackId 
              ? String(rowTrackId) === String(track.trackId)
              : false;
            
            console.log('Primary check:', isCurrent, 'rowTrackId:', rowTrackId, 'track.trackId:', track.trackId);
            
            // Secondary check: Match by Album + Chapter index (If playing same context)
            if (!isCurrent) {
              isCurrent = (String(rowAlbumId) === String(track.bookId) && Number(rowChapIdx) === Number(track.chapIndex));
              console.log('Secondary check:', isCurrent, 'rowAlbumId:', rowAlbumId, 'track.bookId:', track.bookId, 'rowChapIdx:', rowChapIdx, 'track.chapIndex:', track.chapIndex);
            }

            // Tertiary check (Fallback): Match by title + artist 
            if (!isCurrent && track.title) {
              var rowTitle = row.dataset.trackTitle;
              var rowArtist = row.dataset.artistName;
              
              if (rowTitle && rowTitle === track.title) {
                 // Matching by Artist as well if possible for safety
                 if (!track.artist || !rowArtist || rowArtist === track.artist) {
                    isCurrent = true;
                 }
              }
              console.log('Tertiary check:', isCurrent, 'rowTitle:', rowTitle, 'track.title:', track.title, 'rowArtist:', rowArtist, 'track.artist:', track.artist);
            }
            
            console.log('Final isCurrent:', isCurrent);
            
            var titleElement = row.querySelector('[data-player-title]');
            var indexLabel = row.querySelector('[data-index-label]') as HTMLElement;
            
            if (isCurrent) {
              row.setAttribute('data-active', 'true');
              if (titleElement) {
                titleElement.classList.add('text-[#1db954]');
                titleElement.classList.remove('text-white');
              }
              
              if (indexLabel) {
                if (playing) {
                  indexLabel.innerHTML = '<svg fill="#1db954" width="14" height="14" viewBox="0 0 24 24"><path d="M8 9.4c0-.75.7-1.4 1.6-1.4s1.6.65 1.6 1.4v5.2c0 .75-.7 1.4-1.6 1.4s-1.6-.65-1.6-1.4V9.4zM2 13.5c0-.75.7-1.4 1.6-1.4s1.6.65 1.6 1.4v1.1c0 .75-.7 1.4-1.6 1.4S2 15.35 2 14.6v-1.1zm12-7c0-.75.7-1.4 1.6-1.4s1.6.65 1.6 1.4v12.2c0 .75-.7 1.4-1.6 1.4s-1.6-.65-1.6-1.4V6.5zm6 4c0-.75.7-1.4 1.6-1.4s1.6.65 1.6 1.4v4.2c0 .75-.7 1.4-1.6 1.4s-1.6-.65-1.6-1.4v-4.2z"/></svg>';
                } else {
                  var original = indexLabel.dataset.originalIndex || '0';
                  indexLabel.innerHTML = original.length === 1 ? '0' + original : original;
                }
                indexLabel.classList.add('text-[#1db954]');
                indexLabel.classList.remove('text-white/60', 'group-hover:opacity-0');
              }
            } else {
              row.removeAttribute('data-active');
              if (titleElement) {
                titleElement.classList.remove('text-[#1db954]');
                titleElement.classList.add('text-white');
              }
              
              if (indexLabel) {
                var originalValue = indexLabel.dataset.originalIndex || '0';
                indexLabel.innerHTML = originalValue.length === 1 ? '0' + originalValue : originalValue;
                indexLabel.classList.remove('text-[#1db954]');
                indexLabel.classList.add('text-white/60', 'group-hover:opacity-0');
              }
            }
          });
        };
        
        function initTrackHighlighting() {
          if (highlightInterval !== null) clearInterval(highlightInterval);
          
          highlightInterval = setInterval(function() {
            // Wait for the React component/store to attach to window
            if ((window as any).__nanostores_player && (window as any).__nanostores_player.$currentTrack) {
              if (highlightInterval !== null) clearInterval(highlightInterval);
              
              // Subscribe to changes
              (window as any).__nanostores_player.$currentTrack.listen(updateRows);
              (window as any).__nanostores_player.$isPlaying.listen(updateRows);
              
              // Ensure we re-highlight after navigation and page swaps
              document.addEventListener('astro:page-load', updateRows);
              document.addEventListener('app:navigation', updateRows);
              window.addEventListener('app:navigation', updateRows);
              window.addEventListener('app:init', updateRows);
              
              // Immediate run
              updateRows();
            }
          }, 200);
        }

        initTrackHighlighting();
        // Fallback for View transitions: re-init highlighting logic structure if it was lost
        document.addEventListener('astro:after-swap', initTrackHighlighting);
        
        // Also listen for page load immediately
        document.addEventListener('astro:page-load', updateRows);
        document.addEventListener('app:navigation', updateRows);
      })();
    </script>
  </body>
</html>