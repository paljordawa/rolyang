---
import { ClientRouter } from 'astro:transitions';
import Player from '../components/Player.jsx';
import { createSupabaseServerClient } from '../lib/supabaseServer';
import "../styles.css"

const { backHref, playerStart, hidePlayerUntilPlaying } = Astro.props;
const supabase = createSupabaseServerClient(Astro);

// Fetch all albums and tracks for global state
const { data: albumsBase = [] } = await supabase
  .from('albums')
  .select('*, tracks(*)')
  .order('id', { ascending: true });

// Fetch playlists (including system/public ones if any, but usually user-specific)
const { data: { user } } = await supabase.auth.getUser();
let playlists = [];
if (user) {
  const { data: userPlaylists } = await supabase
    .from('playlists')
    .select('*, playlist_tracks(track_id, tracks(*, albums(*)))')
    .eq('user_id', user.id)
    .order('created_at', { ascending: false });
  playlists = userPlaylists || [];
}

const albums = albumsBase.map((album) => ({
  ...album,
  chapters: (album.tracks || []).map((t: any) => ({
    ...t,
    album_id: t.album_id?.toString()
  }))
}));

// Build playable "books" from playlists
const playlistsWithTracks = playlists.map((p: any) => {
  const tracks = (p.playlist_tracks || []).map((pt: any) => ({
    ...pt.tracks,
    album_title: pt.tracks.albums?.title,
    album_artist: pt.tracks.albums?.artist,
    album_cover: pt.tracks.albums?.cover
  }));

  return {
    ...p,
    id: `playlist-${p.id}`,
    artist: 'User Playlist',
    cover: p.cover !== 'gradient' ? p.cover : (tracks[0]?.album_cover || '/social.jpg'),
    chapters: tracks
  };
});

const allBooksForPlayer = [...albums, ...playlistsWithTracks];
const cleanPlaylists = playlists;

const siteTitle = 'Rolyang Music Player';
const siteDescription = 'Listen to curated music from the Rolyang collection.';

// Sanitize playerStart props for React/Astro serialization
const cleanPlayerStart = playerStart ? {
  ...playerStart,
  startBookId: playerStart.startBookId?.toString()
} : null;
const siteOrigin = Astro.site ? Astro.site.origin : '';
const canonicalUrl = siteOrigin ? new URL(Astro.url.pathname + Astro.url.search + Astro.url.hash, siteOrigin).toString() : Astro.url?.href || '';
const ogImagePath = '/social.jpg';
const ogImageUrl = siteOrigin ? new URL(ogImagePath, siteOrigin).toString() : ogImagePath;
---

<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Cover artwork for Rolyang Audiobooks." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="stylesheet" href="/src/styles.css" />
    <ClientRouter />
    <!-- client-only module for navigation and player helpers -->
    <!-- Define playerPlay FIRST, before any other scripts -->
    <script>
      import { navigate } from 'astro:transitions/client';

      // Maps the legacy appNavigate to Astro's official router
      (window as any).appNavigate = (href: string) => {
        console.log('[App] Navigating to:', href);
        navigate(href);
      };

      // Define playerPlay FIRST
      (window as any).playerPlay = (window as any).playerPlay || function (payload: any) {
        window.dispatchEvent(new CustomEvent('player:play', { detail: payload }));
      };
    </script>

    <script>
(function() {
// delegation for player actions using data attributes
function setupPlayerClickHandler() {
  document.addEventListener('click', function(ev) {
    var target = ev.target;
    if (!target) return;

    // 1. Identify if we clicked an internal action button that should NOT trigger playback
    var actionBtn = target.closest('.js-like-btn, .js-add-to-playlist-btn, .js-track-more-btn, button:not([data-player-album]):not([data-player-book])');
    if (actionBtn) return;
    
    // 2. Identify if we clicked a navigation link that should NOT trigger playback 
    //    (Unless it's specifically marked as a play-triggering title)
    var link = target.closest('a');
    if (link && !link.hasAttribute('data-player-title')) return;

    // 3. Search for the playback data container
    var el = target.closest('[data-player-album], [data-player-book]');
    if (el) {
      ev.preventDefault();
      ev.stopPropagation();
      
      var albumId = el.getAttribute('data-player-album') || el.getAttribute('data-player-book');
      var chapIndex = el.getAttribute('data-player-chap') ? Number(el.getAttribute('data-player-chap')) : 0;
      var trackId = el.getAttribute('data-track-id');
      var expand = el.getAttribute('data-player-expand') !== 'false';
      
      // Capture title/artist for fallback highlighting
      var titleElement = el.querySelector('[data-player-title]');
      var title = el.getAttribute('data-track-title') || (titleElement ? titleElement.textContent.trim() : null);
      var artist = el.getAttribute('data-artist-name');
      
      var payload = { bookId: albumId, chapIndex: chapIndex, play: true, expand: expand, trackId: trackId, title: title, artist: artist };
      
      if (window.playerPlay) {
        window.playerPlay(payload);
      } else {
        console.error('window.playerPlay not found');
      }
    }
  });
}

// Setup handlers when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', setupPlayerClickHandler);
} else {
  setupPlayerClickHandler();
}

// No manual popstate. ClientRouter handles this natively.

// simple share button handling
document.addEventListener('click', (ev) => {
  const anyEv = ev;
  const el = anyEv.target && anyEv.target.closest ? anyEv.target.closest('[data-share-button]') : null;
  if (!el) return;
  ev.preventDefault();
  const share = { title: document.title, url: location.href };
  if (navigator.share) navigator.share(share).catch(() => {});
  else navigator.clipboard?.writeText(share.title + ' — ' + share.url);
});

// Re-dispatch app:navigation on initial load so components relying on it can init
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', function() {
    window.dispatchEvent(new Event('app:init'));
  });
} else {
  window.dispatchEvent(new Event('app:init'));
}
})();

console.log('Script initialization complete, window.playerPlay:', typeof window.playerPlay);
    </script>
  </head>
  <body class="bg-surface-base text-white h-[100dvh] overflow-hidden flex flex-col font-sans select-none">
    <div class="flex-1 flex overflow-hidden md:p-3 md:gap-3 h-full md:h-[calc(100svh-95px)] relative">
      <!-- Left Sidebar (Desktop only) -->
      <aside class="hidden md:flex flex-col w-64 lg:w-80 bg-surface-panel/40 backdrop-blur-xl border border-white/5 rounded-xl overflow-hidden flex-shrink-0">
        <!-- Home / Search Nav -->
        <nav class="p-5 space-y-4">
          <a href="/" class="flex items-center gap-5 text-white/70 hover:text-white transition-colors duration-200">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12.5 3.247a1 1 0 00-1 0L4 7.577V20h4.5v-6a1 1 0 011-1h5a1 1 0 011 1v6H20V7.577l-7.5-4.33z"/></svg>
            <span class="font-bold text-sm">Home</span>
          </a>
          <a href="/search" class="flex items-center gap-5 text-white/70 hover:text-white transition-colors duration-200">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <span class="font-bold text-sm">Search</span>
          </a>
        </nav>

        <!-- Library Section -->
        <div class="flex-1 mt-2 bg-white/5 rounded-xl p-3 flex flex-col overflow-hidden">
          <div class="flex items-center justify-between text-white/70 hover:text-white transition-colors duration-200 mb-4 px-2 cursor-pointer group">
            <div class="flex items-center gap-3">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 016.5 2H20v20H6.5a2.5 2.5 0 010-5H20"/></svg>
              <span class="font-bold text-sm">Your Library</span>
            </div>
            <div class="flex gap-2">
              <span id="create-playlist-btn" class="p-1 hover:bg-white/10 rounded-full transition cursor-pointer" title="Create Playlist"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></span>
              <span class="p-1 hover:bg-white/10 rounded-full transition"><svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
            </div>
          </div>
          
          <div class="flex gap-2 px-2 pb-4 overflow-x-auto no-scrollbar">
             <span data-library-filter="playlists" class="px-3 py-1.5 rounded-full text-black bg-white text-xs font-semibold hover:bg-white/20 transition cursor-pointer whitespace-nowrap js-library-pill active-pill">Playlists</span>
             <span data-library-filter="albums" class="px-3 py-1.5 rounded-full bg-white/10 text-xs font-semibold hover:bg-white/20 transition cursor-pointer whitespace-nowrap js-library-pill">Albums</span>
             <span data-library-filter="artists" class="px-3 py-1.5 rounded-full bg-white/10 text-xs font-semibold hover:bg-white/20 transition cursor-pointer whitespace-nowrap js-library-pill">Artists</span>
          </div>
          
          <!-- Library container -->
          <div id="library-list-container" class="overflow-y-auto flex-1 px-1 space-y-1">
            <!-- Items injected by script -->
            <div class="p-4 text-center text-white/40 text-sm">Loading library...</div>
          </div>
          <script id="library-data-json" type="application/json" is:inline set:html={JSON.stringify(albums)} />
          <script is:inline set:html={`window.__libraryData = ${JSON.stringify(albums)}; window.__userPlaylists = ${JSON.stringify(cleanPlaylists)};`} />
        </div>
      </aside>


      <script>
        import { $likedTracks } from '../store/playerStore';

        function renderLibrary(filter: string = 'albums') {
          const container = document.getElementById('library-list-container');
          const pills = document.querySelectorAll('.js-library-pill');
          if (!container) return;
          
          // Ensure data is available
          if (!(window as any).__libraryData) {
            const dataTag = document.getElementById('library-data-json');
            if (dataTag) {
               try {
                 (window as any).__libraryData = JSON.parse(dataTag.textContent || '[]');
                 console.log('Library data parsed successfully');
               } catch(e) {
                 console.error('Failed to parse library data', e);
               }
            }
          }

          const allAlbums = (window as any).__libraryData as any[];
          if (!Array.isArray(allAlbums)) {
            console.error('Library data is not an array', allAlbums);
            return;
          }
          
          // Update visual state
          pills.forEach(p => {
            if (p.getAttribute('data-library-filter') === filter) {
              p.classList.add('bg-white', 'text-black');
              p.classList.remove('bg-white/10', 'text-white');
            } else {
              p.classList.remove('bg-white', 'text-black');
              p.classList.add('bg-white/10', 'text-white');
            }
          });

          let items: any[] = [];
          const likes = $likedTracks.get();

          if (filter === 'playlists') {
            // 1. Synthetic 'Liked Songs' playlist
            items = [{
              id: 'liked-songs',
              name: 'Liked Songs',
              title: 'Liked Songs',
              artist: 'Playlist',
              isLikedSongs: true,
              count: Object.keys(likes).length,
              cover: 'gradient' // Special indicator
            }];
            
            // 2. Real User Playlists
            const userPlaylists = (window as any).__userPlaylists || [];
            items = [...items, ...userPlaylists.map((p: any) => ({
              ...p,
              artist: 'Playlist'
            }))];
          } else if (filter === 'albums') {
            items = allAlbums;
          } else if (filter === 'artists') {
            // Deduplicate by artist
            const artistsMap = new Map();
            const followed = $followedArtists.get();
            
            allAlbums.forEach(a => {
              if (!artistsMap.has(a.artist)) {
                artistsMap.set(a.artist, { 
                  id: a.id, 
                  title: a.artist, 
                  cover: a.cover,
                  isArtist: true,
                  isFollowed: !!(followed as any)[a.artist]
                });
              }
            });
            // Prioritize followed artists
            items = Array.from(artistsMap.values()).sort((a, b) => (b.isFollowed ? 1 : 0) - (a.isFollowed ? 1 : 0));
          } else if (filter === 'liked' || filter === 'liked_detail') {
            // Filter individual tracks from all albums
            allAlbums.forEach(a => {
              a.chapters.forEach((ch: any, i: number) => {
                if ((likes as any)[`${a.id}:${ch.id}`]) {
                  items.push({
                    id: a.id,
                    trackId: ch.id,
                    trackIndex: i,
                    title: ch.title,
                    artist: a.artist,
                    cover: a.cover,
                    isSong: true
                  });
                }
              });
            });
          }

          if (items.length === 0) {
            container.innerHTML = `<div class="p-8 text-center text-white/40 text-sm italic">No items found in your ${filter}.</div>`;
            return;
          }

          container.innerHTML = (filter === 'liked_detail' ? `
            <div class="px-2 py-2 flex items-center gap-2 cursor-pointer text-white/50 hover:text-white transition group" id="library-back-to-playlists">
              <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span class="text-xs font-bold uppercase tracking-wider">Back to Playlists</span>
            </div>
          ` : '') + items.map(item => {
            const href = item.isLikedSongs ? '/collection/tracks' : (item.isArtist ? `/artist/${encodeURIComponent(item.title)}` : (item.artist === 'Playlist' ? `/playlist/${item.id}` : `/album/${item.id}`));
            return `
              <a 
                href="${href}"
                class="flex items-center gap-3 group cursor-pointer hover:bg-white/10 p-2 rounded-md transition-colors relative no-underline" 
                data-library-item
                ${item.isSong ? `data-play-library-song='${JSON.stringify({bookId: item.id, chapIndex: item.trackIndex})}'` : ''}
              >
                <div class="shrink-0 relative">
                  ${item.cover && item.cover !== 'gradient' ? `<img src="${item.cover}" alt="${item.title}" class="w-12 h-12 rounded ${item.isArtist ? 'rounded-full' : ''} object-cover shadow-[0_4px_10px_rgba(0,0,0,0.3)]" />` : ''}
                  ${item.isLikedSongs ? `
                    <div class="absolute inset-0 rounded bg-gradient-to-br from-[#450af5] to-[#8e8ee5] flex items-center justify-center">
                      <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"></path></svg>
                    </div>
                  ` : ''}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium truncate text-white flex items-center gap-2">
                    ${item.title}
                    ${item.isFollowed ? '<div class="w-2 h-2 rounded-full bg-[#1db954]"></div>' : ''}
                    ${item.isFollowed ? '<div class="w-2 h-2 rounded-full bg-brand-primary"></div>' : ''}
                  </div>
                  <div class="text-[12px] text-white/50 truncate mt-0.5">${item.isArtist ? 'Artist' : (item.isLikedSongs ? `Playlist • ${item.count} songs` : (item.isSong ? item.artist : 'Album • ' + (item.artist || '')))}</div>
                </div>
                ${item.isSong ? `
                <div class="opacity-0 group-hover:opacity-100 transition-opacity pr-2">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-brand-primary drop-shadow-[0_0_8px_rgba(99,102,241,0.4)]"><path d="M5.25 5.036a.75.75 0 0 1 1.125-.66l12 7a.75.75 0 0 1 0 1.287l-12 7A.75.75 0 0 1 5.25 19.964V5.036z" /></svg>
                </div>` : ''}
              </a>
            `;
          }).join('');

          // Wire up interactions
          container.querySelectorAll('[data-play-library-song]').forEach(el => {
            el.addEventListener('click', () => {
              // Only play if they didn't click external parts if any
              const data = JSON.parse(el.getAttribute('data-play-library-song') || '{}');
              // @ts-ignore
              if (window.playerPlay) window.playerPlay({ bookId: data.bookId, chapIndex: data.trackIndex });
            });
          });
        }

        // Listen for pill clicks
        document.addEventListener('click', (e) => {
          const pill = (e.target as HTMLElement).closest('.js-library-pill');
          if (pill) {
            const filter = pill.getAttribute('data-library-filter');
            if (filter) renderLibrary(filter);
          }
        });

        // Listen for store updates to refresh views
        $likedTracks.subscribe(() => {
          const activePill = document.querySelector('.js-library-pill.active-pill') || document.querySelector('.js-library-pill.bg-white');
          if (activePill) {
            const currentFilter = activePill.getAttribute('data-library-filter');
            if (currentFilter === 'playlists') renderLibrary('playlists');
            const backBtn = document.getElementById('library-back-to-playlists');
            if (backBtn) renderLibrary('liked_detail');
          }
        });

        // Sync Follow state in sidebar
        import { $followedArtists } from '../store/playerStore';

        // Global creation function
        let currentEditId: string | null = null;
        let trackToAddOnCreate: string | null = null;
        (window as any).createPlaylist = (trackId?: string) => {
          currentEditId = null;
          trackToAddOnCreate = trackId || null;
          const modal = document.getElementById('create-playlist-modal');
          const titleEl = document.getElementById('modal-title');
          const confirmBtn = document.getElementById('confirm-playlist-btn');
          const input = document.getElementById('playlist-name-input') as HTMLInputElement;
          const descInput = document.getElementById('playlist-description-input') as HTMLInputElement;
          
          if (modal && input && titleEl && confirmBtn) {
            titleEl.textContent = 'Create Playlist';
            confirmBtn.textContent = 'Create';
            input.value = `My Playlist #${((window as any).__userPlaylists?.length || 0) + 1}`;
            descInput.value = '';
            modal.classList.remove('hidden');
            input.focus();
            input.select();
          }
        };

        (window as any).openEditPlaylistModal = (data: { id: string, title: string, description: string }) => {
          currentEditId = data.id;
          const modal = document.getElementById('create-playlist-modal');
          const titleEl = document.getElementById('modal-title');
          const confirmBtn = document.getElementById('confirm-playlist-btn');
          const input = document.getElementById('playlist-name-input') as HTMLInputElement;
          const descInput = document.getElementById('playlist-description-input') as HTMLInputElement;

          if (modal && input && titleEl && confirmBtn) {
            titleEl.textContent = 'Edit Details';
            confirmBtn.textContent = 'Save';
            input.value = data.title || '';
            descInput.value = data.description || '';
            modal.classList.remove('hidden');
            input.focus();
          }
        };

        // Modal Action Logic
        (function setupPlaylistModal() {
          const modal = document.getElementById('create-playlist-modal');
          const cancelBtn = document.getElementById('cancel-playlist-btn');
          const confirmBtn = document.getElementById('confirm-playlist-btn');
          const input = document.getElementById('playlist-name-input') as HTMLInputElement;
          const descInput = document.getElementById('playlist-description-input') as HTMLInputElement;

          const closeModal = () => modal?.classList.add('hidden');

          cancelBtn?.addEventListener('click', closeModal);
          modal?.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });

          confirmBtn?.addEventListener('click', async () => {
            const title = input.value.trim();
            const description = descInput.value.trim();
            if (!title) return;

            const isEdit = !!currentEditId;
            confirmBtn.textContent = isEdit ? 'Saving...' : 'Creating...';
            // @ts-ignore
            confirmBtn.disabled = true;

            try {
              const url = isEdit ? `/api/library/playlists/${currentEditId}` : '/api/library/playlists';
              const method = isEdit ? 'PATCH' : 'POST';
              
              const res = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title, description })
              });
              
              if (res.ok) {
                if (!isEdit) {
                  const newPlaylist = await res.json();
                  (window as any).__userPlaylists = [newPlaylist, ...((window as any).__userPlaylists || [])];
                  
                  // Automatically add track if we came from one
                  if (trackToAddOnCreate) {
                    await fetch('/api/library/playlists', {
                      method: 'PUT',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({ playlistId: newPlaylist.id, trackId: trackToAddOnCreate })
                    });
                  }

                  if (typeof renderLibrary === 'function') renderLibrary('playlists');
                  closeModal();
                  if ((window as any).appNavigate) (window as any).appNavigate(`/playlist/${newPlaylist.id}`);
                } else {
                  // Edit mode - update playlist title/description in-place to preserve audio playback.
                  closeModal();
                  const newTitle = title;
                  const newDescription = description;
                  const titleEl = document.querySelector('h1') as HTMLElement;
                  const descEl = document.querySelector('[data-playlist-description]') as HTMLElement;
                  if (titleEl) titleEl.textContent = newTitle;
                  if (descEl) descEl.textContent = newDescription;
                  if ((window as any).__userPlaylists) {
                    (window as any).__userPlaylists = ((window as any).__userPlaylists || []).map((p: any) => {
                      if (p.id === currentEditId) return { ...p, title: newTitle, description: newDescription };
                      return p;
                    });
                  }
                  if (typeof renderLibrary === 'function') renderLibrary('playlists');
                }
              }
            } catch (e) {
              console.error('Failed to handle playlist action:', e);
            } finally {
               confirmBtn.textContent = isEdit ? 'Save' : 'Create';
               // @ts-ignore
               confirmBtn.disabled = false;
            }
          });
        })();

        document.getElementById('create-playlist-btn')?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          (window as any).createPlaylist();
        });

        $followedArtists.subscribe(() => {
          const activePill = document.querySelector('.js-library-pill.active-pill') || document.querySelector('.js-library-pill.bg-white');
          if (activePill && activePill.getAttribute('data-library-filter') === 'artists') {
            renderLibrary('artists');
          }
        });

        // Handle navigation events
        window.addEventListener('app:navigation', () => {
          const isTracks = window.location.pathname === '/collection/tracks';
          if (isTracks) {
            renderLibrary('playlists');
          } else {
            const activePill = document.querySelector('.js-library-pill.active-pill') || document.querySelector('.js-library-pill.bg-white');
            const currentFilter = activePill ? activePill.getAttribute('data-library-filter') : 'albums';
            renderLibrary(currentFilter || 'albums');
          }
        });

        // Lifecycle: DOMContentLoaded, Initial run, and Astro ClientRouter
        document.addEventListener('DOMContentLoaded', () => {
          renderLibrary('playlists');
        });
        
        document.addEventListener('astro:after-swap', () => {
          renderLibrary('playlists');
        });

        // Immediate run
        (function() {
          renderLibrary('playlists');
        })();
      </script>

      <!-- Main Content Area -->
