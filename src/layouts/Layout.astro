           var shell = document.querySelector('[data-player-shell]') as HTMLElement;
           if (ftr) { 
             if (expanded) {
               ftr.style.transform = 'translateY(100%)';
               if(window.innerWidth < 768 && shell) shell.style.bottom = '0px';
             } else {
               ftr.style.transform = 'translateY(0)';
               if(window.innerWidth < 768 && shell) shell.style.bottom = '60px';
             }
           }
        }
        try { update(localStorage.getItem('player:expanded') === 'true'); } catch(e){}
        // @ts-ignore
        window.addEventListener('player:expanded', function(ev){ try { update(ev && ev.detail && ev.detail.expanded === true); } catch(e){} });
