    <script>
      // Highlight active track in TrackRows continuously synced via Nanostores
      document.addEventListener('DOMContentLoaded', () => {
        const checkStore = setInterval(() => {
          // Wait for the React component/store to attach to window
          if (window.__nanostores_player) {
            clearInterval(checkStore);
            
            const updateRows = () => {
              const track = window.__nanostores_player.$currentTrack.get();
              const playing = window.__nanostores_player.$isPlaying.get();
              
              document.querySelectorAll('[data-player-row]').forEach(row => {
                const isCurrent = row.dataset.playerAlbum === track.bookId && Number(row.dataset.playerChap) === track.chapIndex;
                
                const titleEl = row.querySelector('[data-player-title]');
                const indexLabel = row.querySelector('[data-index-label]');
                
                if (isCurrent) {
                  // Title highlight
                  titleEl.classList.add('text-[#1db954]');
                  titleEl.classList.remove('text-white');
                  
                  // Index / Icon highlight
                  if (indexLabel) {
                    if (playing) {
                      // Spotify-style moving EQ icon representation
                      indexLabel.innerHTML = '<svg fill="#1db954" width="14" height="14" viewBox="0 0 24 24"><path d="M8 9.4c0-.75.7-1.4 1.6-1.4s1.6.65 1.6 1.4v5.2c0 .75-.7 1.4-1.6 1.4s-1.6-.65-1.6-1.4V9.4zM2 13.5c0-.75.7-1.4 1.6-1.4s1.6.65 1.6 1.4v1.1c0 .75-.7 1.4-1.6 1.4S2 15.35 2 14.6v-1.1zm12-7c0-.75.7-1.4 1.6-1.4s1.6.65 1.6 1.4v12.2c0 .75-.7 1.4-1.6 1.4s-1.6-.65-1.6-1.4V6.5zm6 4c0-.75.7-1.4 1.6-1.4s1.6.65 1.6 1.4v4.2c0 .75-.7 1.4-1.6 1.4s-1.6-.65-1.6-1.4v-4.2z"/></svg>';
                    } else {
                      indexLabel.innerHTML = indexLabel.dataset.originalIndex;
                    }
                    indexLabel.classList.add('text-[#1db954]');
                    indexLabel.classList.remove('text-white/60');
                    indexLabel.classList.remove('group-hover:opacity-0');
                  }
                } else {
                  // Revert normal styles
                  titleEl.classList.remove('text-[#1db954]');
                  titleEl.classList.add('text-white');
                  
                  if (indexLabel) {
                    indexLabel.innerHTML = indexLabel.dataset.originalIndex;
                    indexLabel.classList.remove('text-[#1db954]');
                    indexLabel.classList.add('text-white/60');
                    indexLabel.classList.add('group-hover:opacity-0');
                  }
                }
              });
            };
            
            // Subscribe to any track or play state changes
            window.__nanostores_player.$currentTrack.subscribe(updateRows);
            window.__nanostores_player.$isPlaying.subscribe(updateRows);
          }
        }, 100);
      });
    </script>
  </body>
</html>